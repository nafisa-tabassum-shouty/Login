            const postId = container.dataset.postId;
            const commentId = container.dataset.commentId;
            const id = postId || commentId;
            const type = postId ? 'post' : 'comment';

            handleReaction(id, type, emojiBtn.dataset.type, container);
            container.classList.remove('show-picker');
        });

        // Hover/Touch handling for picker
        document.body.addEventListener('touchstart', (e) => {
            const btn = e.target.closest('.reaction-btn');
            if (!btn) return;
            const container = btn.closest('.reaction-container');
            if (!container) return;

            setTimeout(() => {
                container.classList.add('show-picker');
            }, 500);
        }, { passive: true });

        // Close picker when clicking outside
        document.body.addEventListener('click', (e) => {
            if (!e.target.closest('.reaction-container')) {
                document.querySelectorAll('.reaction-container.show-picker').forEach(el => el.classList.remove('show-picker'));
            }
        });


        async function handleReaction(id, targetType, reactionType, container) {
            try {
                const endpoint = targetType === 'post'
                    ? `/posts/${id}/react`
                    : `/comments/${id}/react`;

                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reaction_type: reactionType })
                });

                if (response.ok) {
                    const data = await response.json();
                    updateReactionUI(container, data);
                }
            } catch (err) {
                console.error('Reaction error:', err);
            }
        }

        function updateReactionUI(container, data) {
            const btn = container.querySelector('.reaction-btn');

            // Robustly find summary element
            let summary = container.querySelector('.reaction-summary');
            if (!summary) {
                // For posts: it's a sibling in the parent flex container
                if (container.parentElement && container.parentElement.querySelector('.reaction-summary')) {
                    summary = container.parentElement.querySelector('.reaction-summary');
                }
                // For comments: it's inside the comment item (bubble)
                else {
                    const commentItem = container.closest('[id^="comment-"]');
                    if (commentItem) {
                        summary = commentItem.querySelector('.reaction-summary');
                    }
                }
            }

            if (data.userReaction) {
                const type = data.userReaction;
                const emojiMap = {
                    like: { icon: '<span class="material-symbols-outlined fill-current text-primary">thumb_up</span>', label: 'Like', color: 'text-primary' },
                    love: { icon: '<span class="text-[20px]">❤️</span>', label: 'Love', color: 'text-red-500' },
                    haha: { icon: '<span class="text-[20px]">😂</span>', label: 'Haha', color: 'text-yellow-500' },
                    wow: { icon: '<span class="text-[20px]">😮</span>', label: 'Wow', color: 'text-yellow-500' },
                    sad: { icon: '<span class="text-[20px]">😢</span>', label: 'Sad', color: 'text-yellow-500' },
                    angry: { icon: '<span class="text-[20px]">😡</span>', label: 'Angry', color: 'text-orange-600' },
                    care: { icon: '<span class="text-[20px]">🥰</span>', label: 'Care', color: 'text-yellow-500' }
                };
                const config = emojiMap[type];
                btn.innerHTML = `${config.icon}<span class="text-xs font-bold ${config.color}">${config.label}</span>`;
            } else {
                btn.innerHTML = '<span class="material-symbols-outlined text-[18px]">thumb_up</span><span class="text-xs font-bold group-hover:text-primary">Like</span>';
                btn.className = btn.className.replace('text-primary', 'text-[#60758a] hover:text-primary');
            }

            if (data.reactionCount > 0 && summary) {
                let breakdownHtml = '<div class="flex -space-x-1 mr-1">';
                const sortedTypes = Object.keys(data.reactionBreakdown).sort((a, b) => data.reactionBreakdown[b] - data.reactionBreakdown[a]).slice(0, 3);
                sortedTypes.forEach(type => {
                    const emoji = { like: '👍', love: '❤️', haha: '😂', wow: '😮', sad: '😢', angry: '😡', care: '🥰' }[type];
                    // Smaller size for comments if needed, but reusing same classes
                    const sizeClass = container.dataset.commentId ? 'size-3 text-[10px]' : 'size-4';
                    breakdownHtml += `<span class="${sizeClass} flex items-center justify-center bg-white dark:bg-slate-800 rounded-full border border-gray-100 dark:border-slate-700" title="${type}">${emoji}</span>`;
                });
                breakdownHtml += `</div><span class="total-count ${container.dataset.commentId ? 'text-[10px]' : ''}">${data.reactionCount}</span>`;
                summary.innerHTML = breakdownHtml;
            } else if (summary) {
                summary.innerHTML = '';
            }
        }


    <script src="https://unpkg.com/picmo@latest/dist/umd/index.js"></script>
    <script>
        const GIPHY_API_KEY = '<%= process.env.GIPHY_API_KEY %>';

        // Textarea & Selection Logic
        const postTextarea = document.querySelector('textarea[name="content_text"]');

        // Media Preview Logic (Image/GIF)
        const imageInput = document.getElementById('imageInput');
        const gifInput = document.getElementById('gifInput');
        const mediaPreview = document.getElementById('mediaPreview');
        const previewImg = mediaPreview.querySelector('img');
        const removeMedia = document.getElementById('removeMedia');

        imageInput.addEventListener('change', function () {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    previewImg.src = e.target.result;
                    mediaPreview.classList.remove('hidden');
                    gifInput.value = ''; // Clear GIF if image is selected
                }
                reader.readAsDataURL(file);
            }
        });


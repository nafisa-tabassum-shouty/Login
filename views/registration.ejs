<%- include('partials/header') %>

    <div class="flex h-screen w-full overflow-hidden">
        <!-- Left Panel: Brand/Visual -->
        <div class="hidden lg:flex lg:w-1/2 relative flex-col items-center justify-center p-12 overflow-hidden">
            <!-- Background Image with Overlay -->
            <div class="absolute inset-0 z-0">
                <div class="absolute inset-0 bg-primary/40 mix-blend-multiply z-10"></div>
                <div class="absolute inset-0 bg-black/40 z-10"></div>
                <div class="w-full h-full bg-cover bg-center"
                    data-alt="Professional community members collaborating in modern office"
                    style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCl4nT98Tr6ZcNv4GbiJulmyiy-TNhCART6Mf9PiM39qTJqyjtolyM6qu62RR9yFWIIcuj7FXI3SnGalZMbOlv6OUBsA7wbi-WodnjdsaQCcaet3Ic8pq1Dus2AmEAFiJYBhclEoC4WfpL1YSzgMB58vmjVlyvBBbNxhYTL4FUEeKri0qEChlfJRdZXTikXlK94Jgzxcv0vc0D2-c8aFmdGmzjcCxDC_hZWGKChixvdqYxJnjl43ibrvIY0dg1_7d9-12NHrr9hCw');">
                </div>
            </div>
            <!-- Content Overlay -->
            <div class="relative z-20 text-center max-w-md">
                <p class="text-white/90 uppercase tracking-[0.2em] text-sm font-bold mb-4">Join our community</p>
                <h1 class="text-white text-6xl font-black leading-tight mb-6 tracking-tight">Create Account</h1>
                <p class="text-white/80 text-lg font-medium">Start your journey with us today and unlock exclusive
                    professional tools and networking.</p>
            </div>
            <!-- Subtle Decorative Element -->
            <div class="absolute bottom-12 left-12 z-20 flex items-center gap-2">
                <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-white text-xl">rocket_launch</span>
                </div>
                <span class="text-white font-bold tracking-tight">NexusFlow</span>
            </div>
        </div>
        <!-- Right Panel: Registration Form -->
        <div
            class="w-full lg:w-1/2 bg-white dark:bg-background-dark flex flex-col justify-center items-center px-6 py-12 md:px-16 overflow-y-auto">
            <div class="w-full max-w-[480px]">
                <!-- Header -->
                <div class="mb-10 text-center">
                    <h2 class="text-primary text-3xl font-extrabold tracking-tight mb-2">Register Account</h2>
                    <p class="text-slate-500 dark:text-slate-400 text-sm">Please fill in the details below to get
                        started</p>
                </div>
                <!-- Form -->
                <form class="space-y-5" action="/register" method="POST">
                    <!-- Full Name -->
                    <div class="flex flex-col gap-1.5">
                        <label class="text-[#111418] dark:text-white text-sm font-semibold leading-normal px-1">Full
                            Name</label>
                        <div class="relative group">
                            <span
                                class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-primary transition-colors">person</span>
                            <input
                                class="flex w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 h-14 pl-12 pr-4 text-base font-normal placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all shadow-sm"
                                placeholder="Enter your full name" type="text" name="fullName" required />
                        </div>
                    </div>
                    <!-- Email -->
                    <div class="flex flex-col gap-1.5">
                        <label class="text-[#111418] dark:text-white text-sm font-semibold leading-normal px-1">Email
                            ID</label>
                        <div class="relative group">
                            <span
                                class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-primary transition-colors">mail</span>
                            <input
                                class="flex w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 h-14 pl-12 pr-4 text-base font-normal placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all shadow-sm"
                                placeholder="name@company.com" type="email" name="email" required />
                        </div>
                    </div>
                    <!-- Password -->
                    <div class="flex flex-col gap-1.5">
                        <label
                            class="text-[#111418] dark:text-white text-sm font-semibold leading-normal px-1">Password</label>
                        <div class="relative group">
                            <span
                                class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-primary transition-colors">lock</span>
                            <input
                                class="flex w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 h-14 pl-12 pr-4 text-base font-normal placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all shadow-sm"
                                placeholder="Create a password" type="password" name="password" required />
                        </div>
                    </div>
                    <!-- Confirm Password -->
                    <div class="flex flex-col gap-1.5">
                        <label class="text-[#111418] dark:text-white text-sm font-semibold leading-normal px-1">Confirm
                            Password</label>
                        <div class="relative group">
                            <span
                                class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-primary transition-colors">shield</span>
                            <input
                                class="flex w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 h-14 pl-12 pr-4 text-base font-normal placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all shadow-sm"
                                placeholder="Repeat your password" type="password" name="confirmPassword" required />
                        </div>
                    </div>
                    <!-- Terms & Conditions (Contextual Addition for Registration) -->
                    <div class="flex items-center gap-3 py-2">
                        <input class="w-5 h-5 rounded border-slate-300 text-primary focus:ring-primary"
                            type="checkbox" />
                        <label class="text-sm text-slate-600 dark:text-slate-400">
                            I agree to the <a class="text-primary font-bold hover:underline" href="#">Terms of
                                Service</a>
                        </label>
                    </div>
                    <!-- Submit Button -->
                    <button
                        class="w-full bg-primary hover:bg-primary/90 text-white h-14 rounded-xl text-lg font-bold transition-all shadow-lg shadow-primary/20 active:scale-[0.98] mt-4"
                        type="submit">
                        Register
                    </button>
                </form>
                <!-- Footer Navigation -->
                <div class="mt-10 flex flex-col items-center gap-6">
                    <a class="flex items-center gap-2 text-primary font-bold hover:gap-3 transition-all" href="/login">
                        <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                        Back to Login
                    </a>
                    <div class="flex items-center w-full gap-4">
                        <div class="h-px bg-slate-200 dark:bg-slate-700 flex-1"></div>
                        <span class="text-slate-400 text-xs font-bold uppercase tracking-widest">Or continue with</span>
                        <div class="h-px bg-slate-200 dark:bg-slate-700 flex-1"></div>
                    </div>
                    <div class="flex gap-4 w-full">
                        <button
                            class="flex-1 flex items-center justify-center h-12 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
                            <img alt="Google Logo" class="w-5 h-5 mr-2"
                                src="https://lh3.googleusercontent.com/aida-public/AB6AXuBhowrqIFFyPO6ZLzfbhjcHOoAp0bFKl_SbL7aoUYEvTC40H7dc6cTlaF6-iWwVwT9UaG7ez8pkUYIm9Yj5m1eMOZsJi5GSxPw1at-k22kt-nIKQFsHVxqXxp9jV0m8_7LvsCopjmNbh915gZ2kDUQFjXk90Uzdwr_HJT2C4ipQtJKpSw3cxoctHE_b81hV8bb18iTrSo6trLuhJ6SQDR4KnugbePIkB5svCtSLYJ0dpVUUgkIAulB1HedAok6s-Ns9EB76U6vxeA" />
                            <span class="text-sm font-bold text-slate-700 dark:text-slate-200">Google</span>
                        </button>
                        <button
                            class="flex-1 flex items-center justify-center h-12 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
                            <span
                                class="material-symbols-outlined mr-2 text-slate-800 dark:text-white">laptop_mac</span>
                            <span class="text-sm font-bold text-slate-700 dark:text-slate-200">Apple</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
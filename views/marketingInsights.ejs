<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>
        <%= title %>
    </title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;display=swap"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#258cf4",
                        "background-light": "#f5f7f8",
                        "background-dark": "#101922",
                    },
                    fontFamily: {
                        "display": ["Plus Jakarta Sans", "sans-serif"]
                    },
                },
            },
        }
    </script>
    <style>
        body {
            font-family: "Plus Jakarta Sans", sans-serif;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .active-nav {
            background-color: #f0f2f5;
        }

        .dark .active-nav {
            background-color: rgba(37, 140, 244, 0.2);
        }
    </style>
</head>

<body
    class="bg-background-light dark:bg-background-dark text-[#111418] dark:text-white transition-colors duration-200 overflow-x-hidden">

    <div class="flex flex-col min-h-screen">
        <!-- Top Navbar (Simplified for this page) -->
        <header
            class="sticky top-0 z-50 w-full bg-white dark:bg-[#1a242f] border-b border-[#f0f2f5] dark:border-slate-700 px-4 md:px-10 py-3">
            <div class="max-w-[1440px] mx-auto flex items-center justify-between gap-4">
                <div class="flex items-center gap-4 text-primary">
                    <div class="size-8">
                        <svg fill="none" viewbox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                            <path
                                d="M8.57829 8.57829C5.52816 11.6284 3.451 15.5145 2.60947 19.7452C1.76794 23.9758 2.19984 28.361 3.85056 32.3462C5.50128 36.3314 8.29667 39.7376 11.8832 42.134C15.4698 44.5305 19.6865 45.8096 24 45.8096C28.3135 45.8096 32.5302 44.5305 36.1168 42.134C39.7033 39.7375 42.4987 36.3314 44.1494 32.3462C45.8002 28.361 46.2321 23.9758 45.3905 19.7452C44.549 15.5145 42.4718 11.6284 39.4217 8.57829L24 24L8.57829 8.57829Z"
                                fill="currentColor"></path>
                        </svg>
                    </div>
                    <h2
                        class="text-[#111418] dark:text-white text-xl font-bold leading-tight tracking-tight hidden sm:block">
                        SocialApp</h2>
                </div>
                <!-- Right actions -->
                <div class="flex items-center gap-4">
                    <button
                        class="flex size-10 items-center justify-center rounded-lg bg-[#f0f2f5] dark:bg-slate-800 text-[#111418] dark:text-white hover:bg-slate-200 dark:hover:bg-slate-700"
                        onclick="document.documentElement.classList.toggle('dark')">
                        <span class="material-symbols-outlined">dark_mode</span>
                    </button>
                    <a href="/profile"
                        class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-10 border-2 border-primary/20 cursor-pointer active:scale-95 transition-transform"
                        style='background-image: url("/uploads/<%= user && user.profile_picture || "default-profile.png" %>");'></a>
                </div>
            </div>
        </header>

        <!-- Main Content Area -->
        <main class="flex-1 max-w-[1440px] mx-auto w-full px-4 md:px-10 py-6">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                <!-- Left Sidebar: Nav -->
                <aside class="hidden lg:block lg:col-span-3 h-[calc(100vh-120px)] sticky top-24 overflow-y-auto pr-2">
                    <div class="flex flex-col gap-6">
                        <!-- Navigation -->
                        <nav class="flex flex-col gap-2">
                            <a class="flex items-center gap-4 px-4 py-3 rounded-lg hover:bg-[#f0f2f5] dark:hover:bg-slate-800 transition-colors"
                                href="/dashboard">
                                <span class="material-symbols-outlined">home</span>
                                <span class="text-base font-medium">Home</span>
                            </a>
                            <a class="flex items-center gap-4 px-4 py-3 rounded-lg hover:bg-[#f0f2f5] dark:hover:bg-slate-800 transition-colors"
                                href="#">
                                <span class="material-symbols-outlined">explore</span>
                                <span class="text-base font-medium">Explore</span>
                            </a>
                            <a class="flex items-center gap-4 px-4 py-3 rounded-lg active-nav text-primary transition-colors"
                                href="/marketing-insights">
                                <span class="material-symbols-outlined fill-current">insights</span>
                                <span class="text-base font-semibold">Marketing Insights</span>
                            </a>
                            <a class="flex items-center gap-4 px-4 py-3 rounded-lg hover:bg-[#f0f2f5] dark:hover:bg-slate-800 transition-colors"
                                href="/notifications">
                                <span class="material-symbols-outlined">notifications</span>
                                <span class="text-base font-medium">Notifications</span>
                            </a>
                            <a class="flex items-center gap-4 px-4 py-3 rounded-lg hover:bg-[#f0f2f5] dark:hover:bg-slate-800 transition-colors"
                                href="/messages">
                                <span class="material-symbols-outlined">mail</span>
                                <span class="text-base font-medium">Messages</span>
                            </a>
                            <a class="flex items-center gap-4 px-4 py-3 rounded-lg hover:bg-[#f0f2f5] dark:hover:bg-slate-800 transition-colors"
                                href="/profile">
                                <span class="material-symbols-outlined">person</span>
                                <span class="text-base font-medium">Profile</span>
                            </a>
                            <a class="flex items-center gap-4 px-4 py-3 rounded-lg hover:bg-[#f0f2f5] dark:hover:bg-slate-800 transition-colors"
                                href="/settings">
                                <span class="material-symbols-outlined">settings</span>
                                <span class="text-base font-medium">Settings</span>
                            </a>
                            <a class="flex items-center gap-4 px-4 py-3 rounded-lg hover:bg-red-50 dark:hover:bg-red-500/10 text-red-500 transition-colors"
                                href="/logout">
                                <span class="material-symbols-outlined">logout</span>
                                <span class="text-base font-medium">Logout</span>
                            </a>
                        </nav>
                    </div>
                </aside>

                <!-- Center Content -->
                <section class="col-span-1 lg:col-span-9 flex flex-col gap-6">
                    <div
                        class="bg-white dark:bg-[#1a242f] rounded-xl p-6 border border-[#f0f2f5] dark:border-slate-700 shadow-sm">
                        <div class="flex items-center justify-between mb-6">
                            <h1 class="text-2xl font-bold dark:text-white">Marketing Insights</h1>
                            <div
                                class="flex items-center gap-2 bg-green-50 dark:bg-green-500/10 text-green-600 px-3 py-1 rounded-full text-sm font-semibold border border-green-200 dark:border-transparent">
                                <span class="size-2 rounded-full bg-green-500 animate-pulse"></span>
                                PostgreSQL Connected
                            </div>
                        </div>

                        <p class="text-[#60758a] dark:text-gray-300 mb-8">
                            This page is powered by a dedicated PostgreSQL environment, separate from the main MongoDB
                            application database.
                        </p>

                        <% if (pgTime) { %>
                            <div
                                class="bg-[#f0f2f5] dark:bg-slate-800 p-6 rounded-xl border border-gray-200 dark:border-slate-600 mb-6">
                                <h3 class="text-lg font-bold mb-2 dark:text-white">Database Status</h3>
                                <p class="text-sm text-[#60758a] dark:text-gray-400">Connection successful via 'pg'
                                    pool.</p>
                                <div class="mt-4 flex flex-col gap-2">
                                    <div class="flex items-baseline gap-2">
                                        <span class="text-xs font-bold uppercase tracking-wider text-[#60758a]">Server
                                            Time</span>
                                        <span class="font-mono text-primary text-lg">
                                            <%= pgTime %>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <% } else if (locals.error) { %>
                                <div
                                    class="bg-red-50 dark:bg-red-500/10 p-6 rounded-xl border border-red-200 dark:border-red-500/20 mb-6">
                                    <h3 class="text-lg font-bold mb-2 text-red-600">Connection Failed</h3>
                                    <p class="text-sm text-red-800 dark:text-red-400">
                                        <%= error %>
                                    </p>
                                </div>
                                <% } %>

                                    <!-- Placeholder for future charts -->
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                        <div
                                            class="aspect-video bg-gray-50 dark:bg-slate-800/50 rounded-xl border border-dashed border-gray-300 dark:border-slate-700 flex items-center justify-center">
                                            <span class="text-[#60758a] text-sm">Traffic Chart Placeholder</span>
                                        </div>
                                        <div
                                            class="aspect-video bg-gray-50 dark:bg-slate-800/50 rounded-xl border border-dashed border-gray-300 dark:border-slate-700 flex items-center justify-center">
                                            <span class="text-[#60758a] text-sm">Engagement Chart Placeholder</span>
                                        </div>
                                    </div>
                    </div>

                    <!-- CRUD Test Section (New Design) -->
                    <div class="mt-8">
                        <div
                            class="w-full bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-100 dark:border-slate-700 p-10">
                            <div class="flex items-center justify-between mb-10">
                                <div>
                                    <h2 class="text-2xl font-bold text-slate-900 dark:text-white">postgresql crud test
                                    </h2>
                                    <p class="text-base text-slate-500 dark:text-slate-400 mt-1">Manage your profile
                                        updates and snippets.</p>
                                </div>
                            </div>
                            <div class="space-y-6">
                                <div class="grid grid-cols-[120px_1fr] items-center gap-4">
                                    <button id="writeSnippetBtn"
                                        class="bg-primary hover:bg-blue-600 text-white font-medium py-3.5 px-4 rounded-xl transition-colors shadow-sm active:scale-95 flex items-center justify-center gap-2 h-full w-full">
                                        <span>Write</span>
                                    </button>
                                    <div class="relative">
                                        <input id="snippetInput"
                                            class="w-full px-5 py-3.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none text-slate-700 dark:text-slate-200 placeholder:text-slate-400 dark:placeholder:text-slate-500"
                                            placeholder="Type here and press Enter to save" type="text" />
                                        <div id="saveIndicator"
                                            class="absolute right-4 top-1/2 -translate-y-1/2 text-green-500 hidden text-sm font-semibold">
                                            Saved!</div>
                                    </div>
                                </div>
                                <div class="grid grid-cols-[120px_1fr] items-center gap-4">
                                    <button id="readSnippetBtn"
                                        class="bg-primary hover:bg-blue-600 text-white font-medium py-3.5 px-4 rounded-xl transition-colors shadow-sm active:scale-95 flex items-center justify-center gap-2 h-full w-full">
                                        <span>Read</span>
                                    </button>
                                    <div class="relative">
                                        <input id="snippetOutput" readonly
                                            class="w-full px-5 py-3.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none text-slate-700 dark:text-slate-200 placeholder:text-slate-400 dark:placeholder:text-slate-500"
                                            placeholder="will be auto fill this placeholder from database"
                                            type="text" />
                                    </div>
                                </div>
                            </div>
                            <div
                                class="mt-12 pt-8 border-t border-slate-50 dark:border-slate-700 flex items-center justify-between text-sm text-slate-400 dark:text-slate-500">
                                <div class="flex items-center gap-6">
                                    <span class="flex items-center gap-1.5"><span
                                            class="material-symbols-outlined text-[16px]">info</span> Status:
                                        Active</span>
                                    <span class="flex items-center gap-1.5"><span
                                            class="material-symbols-outlined text-[16px]">history</span> Last updated:
                                        Just now</span>
                                </div>
                                <div class="flex gap-4">
                                    <a class="hover:text-primary transition-colors" href="#">Privacy</a>
                                    <span class="text-slate-300">•</span>
                                    <a class="hover:text-primary transition-colors" href="#">Settings</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Data Scraping Section -->
                    <div class="mt-8 mb-20">
                        <div
                            class="w-full bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-100 dark:border-slate-700 p-10">
                            <div class="flex items-center justify-between mb-8">
                                <div>
                                    <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Competitor Analysis
                                    </h2>
                                    <p class="text-base text-slate-500 dark:text-slate-400 mt-1">Scrape and analyze
                                        business data from top platforms.</p>
                                </div>
                            </div>

                            <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8">
                                <button onclick="scrapSource('daraz')"
                                    class="scrap-btn flex flex-col items-center justify-center p-4 rounded-xl border-2 border-slate-100 dark:border-slate-700 hover:border-orange-500 hover:bg-orange-50 dark:hover:bg-slate-700 transition-all group">
                                    <span class="font-bold group-hover:text-orange-600 dark:text-white">Daraz</span>
                                    <span class="text-xs text-slate-400 mt-1">E-commerce</span>
                                </button>
                                <button onclick="scrapSource('bikroy')"
                                    class="scrap-btn flex flex-col items-center justify-center p-4 rounded-xl border-2 border-slate-100 dark:border-slate-700 hover:border-green-500 hover:bg-green-50 dark:hover:bg-slate-700 transition-all group">
                                    <span class="font-bold group-hover:text-green-600 dark:text-white">Bikroy</span>
                                    <span class="text-xs text-slate-400 mt-1">Marketplace</span>
                                </button>
                                <button onclick="scrapSource('rayans')"
                                    class="scrap-btn flex flex-col items-center justify-center p-4 rounded-xl border-2 border-slate-100 dark:border-slate-700 hover:border-red-500 hover:bg-red-50 dark:hover:bg-slate-700 transition-all group">
                                    <span class="font-bold group-hover:text-red-600 dark:text-white">Rayans</span>
                                    <span class="text-xs text-slate-400 mt-1">Tech / Retail</span>
                                </button>
                                <button onclick="scrapSource('pathao')"
                                    class="scrap-btn flex flex-col items-center justify-center p-4 rounded-xl border-2 border-slate-100 dark:border-slate-700 hover:border-red-600 hover:bg-red-50 dark:hover:bg-slate-700 transition-all group">
                                    <span class="font-bold group-hover:text-red-700 dark:text-white">Pathao</span>
                                    <span class="text-xs text-slate-400 mt-1">Logistics</span>
                                </button>
                                <button onclick="scrapSource('shopno')"
                                    class="scrap-btn flex flex-col items-center justify-center p-4 rounded-xl border-2 border-slate-100 dark:border-slate-700 hover:border-emerald-500 hover:bg-emerald-50 dark:hover:bg-slate-700 transition-all group">
                                    <span class="font-bold group-hover:text-emerald-600 dark:text-white">Shopno</span>
                                    <span class="text-xs text-slate-400 mt-1">Grocery</span>
                                </button>
                            </div>

                            <!-- Analysis Result Container -->
                            <div id="scrapResult"
                                class="hidden bg-slate-50 dark:bg-slate-900 rounded-xl p-6 border border-dashed border-slate-200 dark:border-slate-700">
                                <div class="flex items-center gap-2 mb-4">
                                    <span class="animate-spin material-symbols-outlined text-primary"
                                        id="scrapSpinner">sync</span>
                                    <h3 class="font-bold text-lg dark:text-white" id="scrapStatus">Initializing...</h3>
                                </div>
                                <div id="analysisContent" class="hidden space-y-4">
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <div class="bg-white dark:bg-slate-800 p-4 rounded-lg shadow-sm">
                                            <p class="text-xs font-bold text-slate-400 uppercase">Page Title</p>
                                            <p class="text-sm font-medium mt-1 dark:text-white" id="scrapTitle">...</p>
                                        </div>
                                        <div class="bg-white dark:bg-slate-800 p-4 rounded-lg shadow-sm">
                                            <p class="text-xs font-bold text-slate-400 uppercase">Total Word Count</p>
                                            <p class="text-2xl font-bold text-primary mt-1" id="scrapWordCount">0</p>
                                        </div>
                                    </div>
                                    <div class="bg-white dark:bg-slate-800 p-4 rounded-lg shadow-sm">
                                        <p class="text-xs font-bold text-slate-400 uppercase mb-3">Top Keywords</p>
                                        <div class="flex flex-wrap gap-2" id="scrapKeywords"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Scraped Data Table Section -->
                    <div class="mt-8 mb-20">
                        <div
                            class="w-full bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-100 dark:border-slate-700 p-10">
                            <div
                                class="flex flex-col md:flex-row items-start md:items-center justify-between mb-8 gap-4">
                                <div>
                                    <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Live Scraping Report
                                    </h2>
                                    <p class="text-base text-slate-500 dark:text-slate-400 mt-1">Detailed inventory of
                                        products and pages indexed from Daraz.</p>
                                </div>
                                <button onclick="fetchScrapedData()"
                                    class="bg-primary hover:bg-blue-600 text-white font-semibold py-2.5 px-6 rounded-xl transition-all shadow-md hover:shadow-primary/20 active:scale-95 flex items-center gap-2">
                                    <span class="material-symbols-outlined text-xl">database</span>
                                    <span>Sync Scraped Data</span>
                                </button>
                            </div>

                            <div class="overflow-hidden rounded-2xl border border-slate-100 dark:border-slate-700">
                                <div class="overflow-x-auto">
                                    <table class="w-full text-left">
                                        <thead class="bg-slate-50 dark:bg-slate-900/50">
                                            <tr>
                                                <th
                                                    class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-widest">
                                                    Page Source</th>
                                                <th
                                                    class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-widest">
                                                    URL Context</th>
                                                <th
                                                    class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-widest text-center">
                                                    Products</th>
                                                <th
                                                    class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-widest text-center">
                                                    JFY</th>
                                                <th
                                                    class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-widest">
                                                    Status</th>
                                            </tr>
                                        </thead>
                                        <tbody id="scrapedDataTableBody"
                                            class="divide-y divide-slate-100 dark:divide-slate-700">
                                            <tr>
                                                <td colspan="5" class="px-6 py-12 text-center">
                                                    <div class="flex flex-col items-center gap-3">
                                                        <span
                                                            class="material-symbols-outlined text-slate-300 text-4xl">cloud_download</span>
                                                        <p class="text-slate-400 font-medium">Click "Sync Scraped Data"
                                                            to visualize current progress</p>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <script>
                        // CRUD Test Logic
                        const snippetInput = document.getElementById('snippetInput');
                        const saveIndicator = document.getElementById('saveIndicator');
                        const readBtn = document.getElementById('readSnippetBtn');
                        const snippetOutput = document.getElementById('snippetOutput');


                        const writeBtn = document.getElementById('writeSnippetBtn');

                        // Save Function
                        const saveSnippet = async () => {
                            const content = snippetInput.value.trim();
                            if (!content) return;

                            try {
                                const res = await fetch('/marketing-insights/snippet', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ content })
                                });
                                const data = await res.json();

                                if (data.success) {
                                    saveIndicator.classList.remove('hidden');
                                    snippetInput.value = '';
                                    setTimeout(() => {
                                        saveIndicator.classList.add('hidden');
                                    }, 2000);
                                }
                            } catch (err) {
                                console.error('Failed to save snippet', err);
                            }
                        };

                        // Save on Enter
                        snippetInput.addEventListener('keydown', async (e) => {
                            if (e.key === 'Enter') {
                                await saveSnippet();
                            }
                        });

                        // Save on Button Click
                        writeBtn.addEventListener('click', saveSnippet);

                        // Read latest
                        readBtn.addEventListener('click', async () => {
                            try {
                                const res = await fetch('/marketing-insights/snippet');
                                const data = await res.json();

                                if (data.success) {
                                    snippetOutput.value = data.snippet.content;
                                } else {
                                    snippetOutput.value = '';
                                    snippetOutput.placeholder = 'No data found in database.';
                                }
                            } catch (err) {
                                console.error('Failed to fetch snippet', err);
                            }
                        });
                        // Scraping Logic
                        async function scrapSource(source) {
                            const resultContainer = document.getElementById('scrapResult');
                            const spinner = document.getElementById('scrapSpinner');
                            const status = document.getElementById('scrapStatus');
                            const contentDiv = document.getElementById('analysisContent');
                            const titleEl = document.getElementById('scrapTitle');
                            const countEl = document.getElementById('scrapWordCount');
                            const keywordsEl = document.getElementById('scrapKeywords');

                            // Reset UI
                            resultContainer.classList.remove('hidden');
                            contentDiv.classList.add('hidden');
                            spinner.classList.remove('hidden');
                            status.innerText = `Analyzing ${source.charAt(0).toUpperCase() + source.slice(1)}...`
                            status.className = "font-bold text-lg dark:text-white";

                            try {
                                const res = await fetch('/marketing-insights/scrap', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ source })
                                });
                                const response = await res.json();

                                if (response.success && response.data.analysis_summary) {
                                    const analysis = response.data.analysis_summary;

                                    spinner.classList.add('hidden');
                                    status.innerText = "Analysis Complete";
                                    status.classList.add('text-green-600');

                                    titleEl.innerText = analysis.title || 'No Title Found';
                                    countEl.innerText = analysis.wordCount;

                                    // Render keywords
                                    keywordsEl.innerHTML = '';
                                    Object.entries(analysis.topKeywords).forEach(([word, count]) => {
                                        const badge = document.createElement('span');
                                        badge.className = "px-2 py-1 bg-blue-50 text-blue-600 text-xs font-bold rounded-lg border border-blue-100";
                                        badge.innerText = `${word} (${count})`;
                                        keywordsEl.appendChild(badge);
                                    });

                                    contentDiv.classList.remove('hidden');
                                } else {
                                    throw new Error(response.error || 'Unknown error');
                                }
                            } catch (err) {
                                spinner.classList.add('hidden');
                                status.innerText = "Analysis Failed";
                                status.className = "font-bold text-lg text-red-600";
                                console.error(err);
                            }
                        }

                        // Scraped Data Fetching Logic
                        async function fetchScrapedData() {
                            const tableBody = document.getElementById('scrapedDataTableBody');
                            tableBody.innerHTML = '<tr><td colspan="5" class="px-6 py-12 text-center text-slate-400">Loading indexed data...</td></tr>';

                            try {
                                const res = await fetch('/marketing-insights/scraped-data');
                                const response = await res.json();

                                if (response.success && response.data) {
                                    if (response.data.length === 0) {
                                        tableBody.innerHTML = '<tr><td colspan="5" class="px-6 py-12 text-center text-slate-400">No data found in daraz_data.json.</td></tr>';
                                        return;
                                    }

                                    tableBody.innerHTML = '';
                                    response.data.forEach((item, index) => {
                                        const tr = document.createElement('tr');
                                        tr.className = "hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors";
                                        tr.innerHTML = `
                                            <td class="px-6 py-4">
                                                <div class="flex flex-col">
                                                    <span class="text-sm font-bold text-slate-700 dark:text-white truncate max-w-[200px]">${item.title || 'Untitled Page'}</span>
                                                    <span class="text-[10px] text-slate-400 uppercase font-bold tracking-tighter">Daraz Scraper v1.0</span>
                                                </div>
                                            </td>
                                            <td class="px-6 py-4 text-xs text-blue-500 hover:underline truncate max-w-[250px]">
                                                <a href="${item.url}" target="_blank" class="flex items-center gap-1">
                                                    ${item.url}
                                                    <span class="material-symbols-outlined text-[12px]">open_in_new</span>
                                                </a>
                                            </td>
                                            <td class="px-6 py-4 text-center">
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300">
                                                    ${item.products ? item.products.length : 0} Items
                                                </span>
                                            </td>
                                            <td class="px-6 py-4 text-center">
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-300">
                                                    ${item.justForYou ? item.justForYou.length : 0} Items
                                                </span>
                                            </td>
                                            <td class="px-6 py-4">
                                                <div class="flex items-center gap-2">
                                                    <span class="size-2 rounded-full bg-green-500"></span>
                                                    <span class="text-xs font-semibold text-slate-600 dark:text-slate-400">Indexed</span>
                                                </div>
                                            </td>
                                        `;
                                        tableBody.appendChild(tr);
                                    });
                                }
                            } catch (err) {
                                tableBody.innerHTML = '<tr><td colspan="5" class="px-6 py-12 text-center text-red-400 font-bold">Failed to synchronize with scraper output.</td></tr>';
                                console.error(err);
                            }
                        }
                    </script>
                </section>
            </div>
        </main>
    </div>
</body>

</html>
<%- include('partials/header') %>

    <div class="flex flex-col items-center justify-center min-h-[70vh] px-6">
        <div class="w-full max-w-md bg-white dark:bg-zinc-900 p-8 rounded-2xl shadow-xl">
            <div class="text-center mb-8">
                <h2 class="text-primary text-3xl font-extrabold mb-2">Reset Password</h2>
                <p class="text-slate-500 dark:text-slate-400">Enter your new password below.</p>
            </div>
            <form class="space-y-6">
                <div class="space-y-2">
                    <label class="block text-sm font-bold text-slate-700 dark:text-slate-200">New Password</label>
                    <input type="password"
                        class="w-full h-12 px-4 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all"
                        placeholder="••••••••">
                </div>
                <div class="space-y-2">
                    <label class="block text-sm font-bold text-slate-700 dark:text-slate-200">Confirm New
                        Password</label>
                    <input type="password"
                        class="w-full h-12 px-4 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all"
                        placeholder="••••••••">
                </div>
                <button type="submit"
                    class="w-full h-12 bg-primary hover:bg-primary/90 text-white font-bold rounded-xl shadow-lg shadow-primary/20 transition-all active:scale-[0.98]">
                    Update Password
                </button>
            </form>
            <div class="mt-6 text-center">
                <a href="/login" class="text-primary font-bold hover:underline">Back to Login</a>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
                                            class="material-symbols-outlined text-xl group-hover/intro:text-primary transition-colors">work</span>
                                    </div>
                                    <span class="flex-1">
                                        <%= user.workPosition || 'Worker' %> at <strong
                                                class="text-[#111418] dark:text-white">
                                                <%= user.workCompany || 'Personal Studio' %>
                                            </strong>
                                    </span>
                                </div>
                                <% } %>
                                    <% if (user.education) { %>
                                        <div
                                            class="flex items-center gap-4 text-sm text-[#60758a] dark:text-gray-400 group/intro transition-colors hover:text-[#111418] dark:hover:text-white">
                                            <div
                                                class="size-8 rounded-full bg-gray-50/50 dark:bg-gray-800/50 flex items-center justify-center group-hover/intro:bg-primary/10 transition-colors shrink-0">
                                                <span
                                                    class="material-symbols-outlined text-xl group-hover/intro:text-primary transition-colors">school</span>
                                            </div>
                                            <span class="flex-1">Studied at <strong
                                                    class="text-[#111418] dark:text-white">
                                                    <%= user.education %>
                                                </strong></span>
                                        </div>
                                        <% } %>
                                            <% if (user.currentCity) { %>
                                                <div
                                                    class="flex items-center gap-4 text-sm text-[#60758a] dark:text-gray-400 group/intro transition-colors hover:text-[#111418] dark:hover:text-white">
                                                    <div
                                                        class="size-8 rounded-full bg-gray-50/50 dark:bg-gray-800/50 flex items-center justify-center group-hover/intro:bg-primary/10 transition-colors shrink-0">
                                                        <span
                                                            class="material-symbols-outlined text-xl group-hover/intro:text-primary transition-colors">home</span>
                                                    </div>
                                                    <span class="flex-1">Lives in <strong
                                                            class="text-[#111418] dark:text-white">
                                                            <%= user.currentCity %>
                                                        </strong></span>
                                                </div>
                                                <% } %>
                                                    <% if (user.hometown) { %>
                                                        <div
                                                            class="flex items-center gap-4 text-sm text-[#60758a] dark:text-gray-400 group/intro transition-colors hover:text-[#111418] dark:hover:text-white">
                                                            <div
                                                                class="size-8 rounded-full bg-gray-50/50 dark:bg-gray-800/50 flex items-center justify-center group-hover/intro:bg-primary/10 transition-colors shrink-0">
                                                                <span
                                                                    class="material-symbols-outlined text-xl group-hover/intro:text-primary transition-colors">location_on</span>
                                                            </div>
                                                            <span class="flex-1">From <strong
                                                                    class="text-[#111418] dark:text-white">
                                                                    <%= user.hometown %>
                                                                </strong></span>
                                                        </div>
                                                        <% } %>
                                                            <div
                                                                class="flex items-center gap-4 text-sm text-[#60758a] dark:text-gray-400 group/intro transition-colors hover:text-[#111418] dark:hover:text-white">
                                                                <div
                                                                    class="size-8 rounded-full bg-gray-50/50 dark:bg-gray-800/50 flex items-center justify-center group-hover/intro:bg-primary/10 transition-colors shrink-0">
                                                                    <span
                                                                        class="material-symbols-outlined text-xl group-hover/intro:text-primary transition-colors">calendar_month</span>
                                                                </div>
                                                                <span class="flex-1">Joined <strong
                                                                        class="text-[#111418] dark:text-white">
                                                                        <%= new Date(user.createdAt || user.created_at
                                                                            || Date.now()).toLocaleDateString('en-US', {
                                                                            month: 'long' , year: 'numeric' }) %>
                                                                    </strong></span>
                                                            </div>
                        </div>
                        <label for="edit-details-toggle"
                            class="w-full mt-6 block py-2 bg-[#f0f2f5] dark:bg-[#2d3a48] font-bold rounded-lg hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors text-center cursor-pointer">
                            Edit Details
                        </label>
                    </section>
                    <!-- Photos Grid Preview -->
                    <section
                        class="bg-white dark:bg-[#1a242d] p-6 rounded-xl shadow-sm border border-[#f0f2f5] dark:border-[#2d3a48]">
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="text-xl font-bold">Photos</h3>
                            <a class="text-primary text-sm font-semibold" href="#">See All</a>
                        </div>
                        <div class="grid grid-cols-3 gap-2">
                            <div class="aspect-square bg-cover bg-center rounded-lg"
                                data-alt="Modern architecture photo"
                                style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuBLe2bZwWtTGBJ-iua2JIVTQhAp7sZ22woHEfsYSeCbMmFCipMGNikPJ2Lgc5mGnkeWFRrlpdGAHScJlGI0idUPgqHtH_0OMNt3aKtHs31YEtPZhlaeghcvH2VHnXmG_RukbWqjkoC8E240p7uARny1IienJbOOMamRi6LiOGMFqq3TJxdfetrP90qMFhaKSkupuH6oH8tPPbiSV1-7ifRGG89edcJgOWvZKw1FS0Axzw7eOwjydsHSQG1xYmKtscHe_vY3a754KwM");'>
                            </div>
                            <div class="aspect-square bg-cover bg-center rounded-lg" data-alt="Sunset landscape photo"
                                style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuD9VumSqbXRuuDTfMEFRYk8zOoh1RT2_AcVhfUS-BsUN1n2GcaVfArOLD-lCmG5OvSYmSWsLi5fIEXld-EWDGAJskOJtWig1c98FfG6QQzpl1bVbBaCkCNfQaKRQgLlxZb96uimWe4X2ihIIq4L2bxOvX2lYpb_RIl3T5xC__NJiFuItaS7NxtL0soKT0h1pSroWW6iXXgxK4uzhU_wQWUwXsFDrL6dwKjlS16FH9EWqys7q4pVZKxCcrNfJeBDlGNeVc3PixFgfHs");'>
                            </div>
                            <div class="aspect-square bg-cover bg-center rounded-lg"
                                data-alt="Cozy interior office space"
                                style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuAt7G4TKFqgsEDoTW5Zkzp6E5x5FLGFIMZYtwpC9tE3ISCjaK3jdJxb3CvWmo0ZWGpSKxAjR3CegffYShj9bgh7yV_K5-GghiVZQu-VKb7j6m_WFvUmuJLzMEuewEbk14Hy0S2S8PV9kosHyGmZ9XdGTWPJhuv-qn63nJ_zslDl_3QrCzQOJN6kM8DCPiJ8-xQg_juFhc0q-lxeZwe840vOtyd5kBr3LBiqIueJ55iZU_J8MLp79XXR3-tWdzTll-zSINSiCwgXeRs");'>
                            </div>
                            <div class="aspect-square bg-cover bg-center rounded-lg" data-alt="Mountain range view"
                                style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuDS8GsmlW_haX4poDsTk-hjaYaVl4osiWnacNebeMbeQlTbeo3iQlc_D66SMSLBElW9ce9GV4b3nNAjgFOI2OZaE1VNY-4bkQY8yk5jzxYo8aO_hHwTrftA8K593MiO6gN3I_rR0RMxZG2GVh0SSgLcyzG0_vQzYFpmvCUJWH4mmrBqu9cZ-3m5x3AhwrKEquHf1PbsANyfbRH6x5t-M1B80sfnSfoHzWlGYL2BozqTp4oNQoDi8-rhOoKBmA0qI1A5Y3eIji1JvuA");'>
                            </div>
                            <div class="aspect-square bg-cover bg-center rounded-lg" data-alt="Forest greenery"
                                style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuAFaUcXClsjF4Hj0qHNvF7_i1eGi50LsXkdNrX3h2k7ZS-muPVzFcFB6PA7SZ_nZSyDIUT1v9vgs98bNtXsQpDsZZmwEWNnrE4Y7EJ6VRiCGSGKVI29rSMYbMDKMp10ysJU7svwTPRmIRS9xKdlXDDIG34buI3qHQJ4U2YdikAFpCkvyBzrJ8W-FWHDIQaybNDm76hkQun9j_swmhpQfJYaJQ5L48cdZuQ1wBs-fpGdIn9uovW4CugMBkhJBjVfViPVSTIoNWdIEqc");'>
                            </div>
                            <div class="aspect-square bg-cover bg-center rounded-lg" data-alt="Abstract art painting"
                                style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuBXdKrSx_hJ1Plgex8BQuHT_SkScEq9jgGmnx8jusilYPUgOTnsAKeDn1F5fuPV2lTYGjET3QX1Ujv2Ll77H9X4MMUs_2NTzq-w8Mk4HEqfbr5nL2XwMG6M16noRmnxqG81bj9ECnqluFgI6ecS-F6dJTNlHlrCEW6aWexUB1DuOTdbLrCVOWOj1SvHLa7jpK8S-9ro-704vvvQ-JTp6y4QU21ZKTWv18r9RexGQG58PXQUdLsOG0wcg1Ccaif9tn4LendvgzQ3oGg");'>
                            </div>
                        </div>
                    </section>
                </div>
                <!-- Right Column: Posts Feed -->
                <div class="lg:col-span-8 space-y-6">
                    <!-- Create Post Placeholder -->
                    <!-- Post Composer (Synchronized with Dashboard) -->
                    <div
                        class="bg-white dark:bg-[#1a242d] p-6 rounded-xl shadow-sm border border-[#f0f2f5] dark:border-[#2d3a48]">
                        <form action="/posts" method="POST" enctype="multipart/form-data">
                            <div class="flex gap-4">
                                <div class="size-12 rounded-full bg-cover bg-center shrink-0"
                                    data-alt="Your profile avatar"
                                    style='background-image: url("/uploads/<%= user.profile_picture || "default-profile.png" %>");'>
                                </div>
                                <div class="flex-1">
                                    <textarea name="content_text"
                                        class="w-full min-h-[100px] bg-transparent border-none focus:ring-0 text-lg resize-none placeholder:text-[#bac4cf] dark:text-white"
                                        placeholder="What's on your mind, <%= user.fullName.split(' ')[0] %>?"></textarea>

                                    <!-- Image/GIF Preview Area -->
                                    <div id="mediaPreview" class="hidden mb-4 relative">
                                        <img src="" alt="Preview"
                                            class="max-h-60 rounded-xl border border-[#f0f2f5] dark:border-[#2d3a48]">
                                        <button type="button" id="removeMedia"
                                            class="absolute top-2 right-2 bg-black/50 text-white rounded-full p-1 hover:bg-black/70">
                                            <span class="material-symbols-outlined text-sm">close</span>
                                        </button>
                                    </div>

                                    <!-- Poll Creation Area -->
                                    <div id="pollCreator"
                                        class="hidden mb-4 p-4 border border-[#f0f2f5] dark:border-[#2d3a48] rounded-xl bg-gray-50 dark:bg-slate-800/50">
                                        <div class="flex justify-between items-center mb-3">
                                            <h4 class="font-bold text-sm dark:text-white">Create Poll</h4>
                                            <button type="button" id="removePoll"
                                                class="text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 p-1 rounded-full transition-colors">
                                                <span class="material-symbols-outlined text-sm">close</span>
                                            </button>
                                        </div>
                                        <div id="pollOptionsContainer" class="flex flex-col gap-2">
                                            <input type="text" name="poll_options[]" placeholder="Option 1"
                                                class="w-full px-4 py-2 bg-white dark:bg-slate-900 border border-[#f0f2f5] dark:border-[#2d3a48] rounded-lg text-sm dark:text-white focus:ring-1 focus:ring-primary outline-none">
                                            <input type="text" name="poll_options[]" placeholder="Option 2"
                                                class="w-full px-4 py-2 bg-white dark:bg-slate-900 border border-[#f0f2f5] dark:border-[#2d3a48] rounded-lg text-sm dark:text-white focus:ring-1 focus:ring-primary outline-none">
                                        </div>
                                        <button type="button" id="addPollOption"
                                            class="mt-3 text-primary text-sm font-bold flex items-center gap-1 hover:underline">
                                            <span class="material-symbols-outlined text-sm">add</span> Add an option
                                        </button>
                                        <div class="mt-4 pt-4 border-t border-[#f0f2f5] dark:border-[#2d3a48]">
                                            <label class="block text-xs font-bold text-[#60758a] uppercase mb-2">Poll
                                                Length</label>
                                            <select name="poll_duration"
                                                class="w-full bg-white dark:bg-slate-900 border border-[#f0f2f5] dark:border-[#2d3a48] rounded-lg px-3 py-2 text-sm dark:text-white outline-none">
                                                <option value="1">1 Day</option>
                                                <option value="3">3 Days</option>
                                                <option value="7">7 Days</option>
                                            </select>
                                        </div>
                                    </div>

                                    <!-- Schedule Panel -->
                                    <div id="schedulePanel"
                                        class="hidden mb-4 p-4 border border-[#f0f2f5] dark:border-[#2d3a48] rounded-xl bg-gray-50 dark:bg-slate-800/50">
                                        <div class="flex justify-between items-center mb-3">
                                            <h4 class="font-bold text-sm dark:text-white">Schedule Post</h4>
                                            <button type="button" id="removeSchedule"
                                                class="text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 p-1 rounded-full transition-colors">
                                                <span class="material-symbols-outlined text-sm">close</span>
                                            </button>
                                        </div>
                                        <div class="flex flex-col gap-3">
                                            <div class="flex-1">
                                                <label
                                                    class="block text-xs font-bold text-[#60758a] uppercase mb-2">Publish
                                                    Date & Time</label>
                                                <input type="datetime-local" name="scheduled_at" id="scheduledAt"
                                                    class="w-full px-4 py-2 bg-white dark:bg-slate-900 border border-[#f0f2f5] dark:border-[#2d3a48] rounded-lg text-sm dark:text-white focus:ring-1 focus:ring-primary outline-none">
                                            </div>
                                            <div class="flex items-center justify-between">
                                                <label
                                                    class="flex items-center gap-2 text-sm dark:text-gray-300 cursor-pointer">
                                                    <input type="checkbox" id="scheduleToggle" name="is_scheduled"
                                                        value="true"
                                                        class="w-4 h-4 rounded text-primary border-gray-300 focus:ring-primary">
                                                    Schedule this post
                                                </label>
                                                <button type="button" id="clearSchedule"
                                                    class="text-sm text-primary font-semibold hover:underline">
                                                    Clear
                                                </button>
                                            </div>
                                            <p class="text-[11px] text-[#60758a]">Post will be hidden until the selected
                                                time.</p>
                                        </div>
                                    </div>

                                    <div
                                        class="flex items-center justify-between pt-3 border-t border-[#f0f2f5] dark:border-[#2d3a48]">
                                        <div class="flex gap-1 text-primary">
                                            <input type="file" name="content_image" id="imageInput" class="hidden"
                                                accept="image/*">
                                            <input type="hidden" name="content_gif" id="gifInput">

                                            <button type="button"
                                                onclick="document.getElementById('imageInput').click()"
                                                class="p-2 rounded-full hover:bg-primary/10 transition-colors">
                                                <span class="material-symbols-outlined">image</span>
                                            </button>
                                            <button type="button" id="gifPickerBtn"
                                                class="p-2 rounded-full hover:bg-primary/10 transition-colors">
                                                <span class="material-symbols-outlined">gif_box</span>
                                            </button>
                                            <button type="button" id="pollBtn"
                                                class="p-2 rounded-full hover:bg-primary/10 transition-colors">
                                                <span class="material-symbols-outlined">ballot</span>
                                            </button>
                                            <div class="relative">
                                                <button type="button" id="emojiPickerBtn"
                                                    class="p-2 rounded-full hover:bg-primary/10 transition-colors">
                                                    <span class="material-symbols-outlined">mood</span>
                                                </button>
                                                <!-- Emoji Picker Container -->
                                                <div id="emojiPickerContainer"
                                                    class="absolute top-full left-0 mt-2 z-[110] hidden shadow-2xl rounded-2xl overflow-hidden bg-white dark:bg-[#1a242f]">
                                                </div>
                                            </div>
                                            <button type="button" id="scheduleBtn"
                                                class="p-2 rounded-full hover:bg-primary/10 transition-colors">
                                                <span class="material-symbols-outlined">calendar_month</span>
                                            </button>
                                        </div>
                                        <button type="submit"
                                            class="bg-primary text-white px-6 py-2 rounded-full font-bold text-sm hover:bg-primary/90 transition-all disabled:opacity-50">Post</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                    <!-- Post Feed Sort -->
                    <div class="flex justify-between items-center px-2">
                        <h3 class="text-xl font-bold">Posts</h3>
                        <button
                            class="flex items-center gap-1 bg-white dark:bg-[#1a242d] px-3 py-1.5 rounded-lg border border-[#f0f2f5] dark:border-[#2d3a48] text-sm font-bold">
                            <span class="material-symbols-outlined text-base">tune</span>
                            Filters
                        </button>
                    </div>
                    <div class="flex flex-col gap-4">
                        <% if (posts && posts.length> 0) { %>
                            <% posts.forEach(post=> { %>
                                <article
                                    class="bg-white dark:bg-[#1a242f] rounded-xl border border-[#f0f2f5] dark:border-slate-700 overflow-hidden shadow-sm">
                                    <div class="p-4">
                                        <div class="flex items-start justify-between">
                                            <div class="flex gap-3">
                                                <div class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-12"
                                                    data-alt="<%= post.user_id ? post.user_id.fullName : 'Unknown User' %> profile"
                                                    style='background-image: url("/uploads/<%= (post.user_id && post.user_id.profile_picture) ? post.user_id.profile_picture : "default-profile.png" %>");'>
                                                </div>
                                                <div>
                                                    <div class="flex items-center gap-1">
                                                        <h4 class="font-bold text-[#111418] dark:text-white">
                                                            <%= post.user_id ? post.user_id.fullName : 'Deleted User' %>
                                                        </h4>
                                                        <% if (post.user_id && post.user_id.verified) { %>
                                                            <span
                                                                class="material-symbols-outlined text-primary text-[18px] fill-current">verified</span>
                                                            <% } %>
                                                    </div>
                                                    <p class="text-sm text-[#60758a]">@<%= (post.user_id &&
                                                            post.user_id.username) ? post.user_id.username : 'user' %> •
                                                            <%= new Date(post.created_at).toLocaleDateString() %>
                                                    </p>
                                                </div>
                                            </div>
                                            <button
                                                class="text-[#60758a] hover:bg-[#f0f2f5] dark:hover:bg-slate-800 p-1 rounded-full">
                                                <span class="material-symbols-outlined">more_horiz</span>
                                            </button>
                                        </div>
                                        <div class="mt-3">
                                            <p class="text-[#111418] dark:text-slate-200 leading-relaxed mb-4">
                                                <%= post.content_text %>
                                            </p>

                                            <% if (post.content_image) { %>
                                                <div class="w-full bg-center bg-no-repeat aspect-video bg-cover rounded-xl mb-4 border border-[#f0f2f5] dark:border-slate-700"
                                                    style='background-image: url("/uploads/<%= post.content_image %>");'>
                                                </div>
                                                <% } %>

                                                    <% if (post.content_gif) { %>
                                                        <div class="w-full mb-4">
                                                            <img src="<%= post.content_gif %>" alt="GIF content"
                                                                class="w-full rounded-xl border border-[#f0f2f5] dark:border-slate-700">
                                                        </div>
                                                        <% } %>

                                                            <% if (post.poll && post.poll.options &&
                                                                post.poll.options.length> 0) {
                                                                %>
                                                                <div class="poll-container mb-4 flex flex-col gap-2"
                                                                    data-post-id="<%= post._id %>">
                                                                    <% const totalVotes=post.poll.options.reduce((acc,
                                                                        opt)=> acc +
                                                                        (opt.votes ? opt.votes.length : 0),
                                                                        0);
                                                                        const hasVoted = post.poll.options.some(opt =>
                                                                        opt.votes && opt.votes.some(v => v.toString()
                                                                        === user._id.toString()));
                                                                        const isExpired = post.poll.expires_at && new
                                                                        Date(post.poll.expires_at) < new Date(); %>
                                                                            <% post.poll.options.forEach((option, idx)=>
                                                                                { %>
                                                                                <% const voteCount=option.votes ?
                                                                                    option.votes.length : 0; %>
                                                                                    <% const percentage=totalVotes> 0 ?
                                                                                        Math.round((voteCount /
                                                                                        totalVotes) * 100) : 0; %>
                                                                                        <button type="button"
                                                                                            class="poll-option-btn relative w-full p-3 rounded-lg border border-[#f0f2f5] dark:border-slate-700 text-left overflow-hidden transition-all <%= hasVoted || isExpired ? 'cursor-default' : 'hover:bg-primary/5' %>"
                                                                                            data-option-id="<%= option._id %>"
                                                                                            <%=hasVoted || isExpired
                                                                                            ? 'disabled' : '' %>>
                                                                                            <div
                                                                                                class="relative z-10 flex justify-between items-center w-full">
                                                                                                <span
                                                                                                    class="font-medium text-sm dark:text-white">
                                                                                                    <%= option.text %>
                                                                                                </span>
                                                                                                <% if (hasVoted ||
                                                                                                    isExpired) { %>
                                                                                                    <span
                                                                                                        class="text-xs font-bold text-[#60758a]">
                                                                                                        <%= percentage
                                                                                                            %>%
                                                                                                    </span>
                                                                                                    <% } %>
                                                                                            </div>
                                                                                            <% if (hasVoted ||
                                                                                                isExpired) { %>
                                                                                                <div class="absolute inset-0 bg-primary/10 transition-all duration-500"
                                                                                                    style="width: <%= percentage %>%">
                                                                                                </div>
                                                                                                <% } %>
                                                                                        </button>
                                                                                        <% }) %>
                                                                                            <div
                                                                                                class="flex justify-between items-center mt-1">
                                                                                                <p
                                                                                                    class="text-xs text-[#60758a]">
                                                                                                    <%= totalVotes %>
                                                                                                        votes • <%=
                                                                                                            isExpired

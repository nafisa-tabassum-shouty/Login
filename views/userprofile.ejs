        <script src="https://unpkg.com/picmo@latest/dist/umd/index.js"></script>
        <script>
            const GIPHY_API_KEY = '<%= process.env.GIPHY_API_KEY %>';

            // Textarea & Selection Logic
            const postTextarea = document.querySelector('textarea[name="content_text"]');

            // Media Preview Logic (Image/GIF)
            const imageInput = document.getElementById('imageInput');
            const gifInput = document.getElementById('gifInput');
            const mediaPreview = document.getElementById('mediaPreview');
            const previewImg = mediaPreview.querySelector('img');
            const removeMedia = document.getElementById('removeMedia');

            if (imageInput) {
                imageInput.addEventListener('change', function () {
                    const file = this.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            previewImg.src = e.target.result;
                            mediaPreview.classList.remove('hidden');
                            gifInput.value = ''; // Clear GIF if image is selected
                        }
                        reader.readAsDataURL(file);
                    }
                });
            }

            if (removeMedia) {
                removeMedia.addEventListener('click', function () {
                    imageInput.value = '';
                    gifInput.value = '';
                    mediaPreview.classList.add('hidden');
                    previewImg.src = '';
                });
            }

            // Emoji Picker Logic
            const emojiPickerBtn = document.getElementById('emojiPickerBtn');
            const emojiPickerContainer = document.getElementById('emojiPickerContainer');
            let picker = null;

            if (emojiPickerBtn) {
                emojiPickerBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (!picker) {
                        picker = picmo.createPicker({
                            rootElement: emojiPickerContainer,
                            theme: document.documentElement.classList.contains('dark') ? 'dark' : 'light'
                        });

                        picker.addEventListener('emoji:select', (selection) => {
                            const start = postTextarea.selectionStart;
                            const end = postTextarea.selectionEnd;
                            const text = postTextarea.value;
                            const before = text.substring(0, start);
                            const after = text.substring(end, text.length);
                            postTextarea.value = before + selection.emoji + after;
                            postTextarea.selectionStart = postTextarea.selectionEnd = start + selection.emoji.length;
                            postTextarea.focus();
                        });
                    }
                    emojiPickerContainer.classList.toggle('hidden');
                });
            }

            // Close search/pickers when clicking outside
            document.addEventListener('click', (e) => {
                if (picker && !emojiPickerContainer.contains(e.target) && e.target !== emojiPickerBtn) {
                    emojiPickerContainer.classList.add('hidden');
                }
            });

            // GIF Picker Logic
            const gifModal = document.getElementById('gifModal');
            const gifPickerBtn = document.getElementById('gifPickerBtn');
            const closeGifModal = document.getElementById('closeGifModal');
            const gifSearch = document.getElementById('gifSearch');
            const gifResults = document.getElementById('gifResults');

            if (gifPickerBtn) {
                gifPickerBtn.addEventListener('click', () => {
                    gifModal.classList.remove('hidden');
                    fetchTrendingGifs();
                });
            }

            if (closeGifModal) closeGifModal.addEventListener('click', () => gifModal.classList.add('hidden'));

            let searchTimeout;
            if (gifSearch) {
                gifSearch.addEventListener('input', (e) => {
                    clearTimeout(searchTimeout);
                    searchTimeout = setTimeout(() => {
                        const query = e.target.value;
                        if (query) {
                            searchGifs(query);
                        } else {
                            fetchTrendingGifs();
                        }
                    }, 500);
                });
            }

            async function fetchTrendingGifs() {
                try {
                    const response = await fetch(`https://api.giphy.com/v1/gifs/trending?api_key=${GIPHY_API_KEY}&limit=20`);
                    const { data } = await response.json();
                    displayGifs(data);
                } catch (err) {
                    console.error('Error fetching trending GIFs:', err);
                }
            }

            async function searchGifs(query) {
                try {
                    const response = await fetch(`https://api.giphy.com/v1/gifs/search?api_key=${GIPHY_API_KEY}&q=${query}&limit=20`);
                    const { data } = await response.json();
                    displayGifs(data);
                } catch (err) {
                    console.error('Error searching GIFs:', err);
                }
            }

            function displayGifs(gifs) {
                if (!gifResults) return;
                gifResults.innerHTML = '';
                gifs.forEach(gif => {
                    const img = document.createElement('img');
                    img.src = gif.images.fixed_height.url;
                    img.className = 'w-full h-32 object-cover rounded-lg cursor-pointer hover:opacity-80 transition-opacity';
                    img.onclick = () => {
                        selectGif(gif.images.original.url);
                    };
                    gifResults.appendChild(img);
                });
            }

            function selectGif(url) {
                gifInput.value = url;
                previewImg.src = url;
                mediaPreview.classList.remove('hidden');
                imageInput.value = ''; // Clear image if GIF is selected
                gifModal.classList.add('hidden');
            }

            // Poll Logic
            const pollBtn = document.getElementById('pollBtn');
            const pollCreator = document.getElementById('pollCreator');
            const removePoll = document.getElementById('removePoll');
            const addPollOption = document.getElementById('addPollOption');
            const pollOptionsContainer = document.getElementById('pollOptionsContainer');

            if (pollBtn) {
                pollBtn.addEventListener('click', () => {
                    pollCreator.classList.toggle('hidden');
                    if (!pollCreator.classList.contains('hidden')) {
                        // Focus the first option when opened
                        pollOptionsContainer.querySelector('input').focus();
                        // Disable image/gif if poll is active (X style)
                        imageInput.value = '';
                        gifInput.value = '';
                        mediaPreview.classList.add('hidden');
                    }
                });
            }

            if (removePoll) {
                removePoll.addEventListener('click', () => {
                    pollCreator.classList.add('hidden');
                    // Clear inputs
                    pollOptionsContainer.querySelectorAll('input').forEach(input => input.value = '');
                });
            }

            if (addPollOption) {
                addPollOption.addEventListener('click', () => {
                    const inputs = pollOptionsContainer.querySelectorAll('input');
                    if (inputs.length < 4) {
                        const newInput = document.createElement('input');
                        newInput.type = 'text';
                        newInput.name = 'poll_options[]';
                        newInput.placeholder = `Option ${inputs.length + 1}`;
                        newInput.className = 'w-full px-4 py-2 bg-white dark:bg-slate-900 border border-[#f0f2f5] dark:border-[#2d3a48] rounded-lg text-sm dark:text-white focus:ring-1 focus:ring-primary outline-none';
                        pollOptionsContainer.appendChild(newInput);
                        newInput.focus();

                        if (inputs.length + 1 === 4) {
                            addPollOption.classList.add('hidden');
                        }
                    }
                });
            }

            // Schedule Logic
            const scheduleBtn = document.getElementById('scheduleBtn');
            const schedulePanel = document.getElementById('schedulePanel');
            const scheduleToggle = document.getElementById('scheduleToggle');
            const scheduledAt = document.getElementById('scheduledAt');
            const clearSchedule = document.getElementById('clearSchedule');
            const removeSchedule = document.getElementById('removeSchedule');

            if (scheduledAt) scheduledAt.disabled = true;

            if (scheduleBtn) {
                scheduleBtn.addEventListener('click', () => {
                    schedulePanel.classList.toggle('hidden');
                });
            }

            if (scheduleToggle) {
                scheduleToggle.addEventListener('change', () => {
                    scheduledAt.disabled = !scheduleToggle.checked;
                    if (scheduleToggle.checked && !scheduledAt.value) {
                        const now = new Date();
                        now.setHours(now.getHours() + 1);
                        now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
                        scheduledAt.value = now.toISOString().slice(0, 16);
                    }
                    if (!scheduleToggle.checked) scheduledAt.value = "";
                });
            }

            if (clearSchedule) {
                clearSchedule.addEventListener('click', () => {
                    scheduleToggle.checked = false;
                    scheduledAt.value = "";
                    scheduledAt.disabled = true;
                });
            }

            if (removeSchedule) {
                removeSchedule.addEventListener('click', () => {
                    schedulePanel.classList.add('hidden');
                });
            }

            // Voting Logic
            document.querySelectorAll('.poll-option-btn').forEach(btn => {
                btn.addEventListener('click', async function () {
                    if (this.disabled) return;

                    const postId = this.closest('.poll-container').dataset.postId;
                    const optionId = this.dataset.optionId;

                    try {
                        const response = await fetch(`/posts/${postId}/vote`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ optionId })
                        });

                        if (response.ok) {
                            window.location.reload(); // Simple reload for now to reflect votes
                        } else {
                            const err = await response.text();
                            alert(err);
                        }
                    } catch (err) {
                        console.error('Voting error:', err);
                    }
                });
            });

            // Unified Reaction and Comment Logic
            const postCommentStates = {};

            function initCommentToggles() {
                document.querySelectorAll('.comment-toggle-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const article = btn.closest('article');
                        const section = article.querySelector('.comments-section');
                        if (!section) return;

                        const isShowing = section.classList.toggle('show');
                        const postId = section.id.replace('comments-', '');

                        if (isShowing && !postCommentStates[postId]) {
                            postCommentStates[postId] = { page: 1, loading: false };
                            loadComments(postId);
                        }
                    });
                });
            }

            async function loadComments(postId, loadMore = false) {
                const state = postCommentStates[postId];
                if (state.loading) return;
                state.loading = true;

                const section = document.getElementById(`comments-${postId}`);
                const loader = section.querySelector('.comment-skeletons');
                const container = section.querySelector('.comments-container');
                const loadMoreBtn = section.querySelector('.load-more-comments');
                const emptyState = section.querySelector('.empty-comments');

                if (!loadMore) loader.classList.remove('hidden');

                try {
                    const res = await fetch(`/posts/${postId}/comments?page=${state.page}`);
                    const data = await res.json();

                    loader.classList.add('hidden');
                    if (data.comments.length === 0 && !loadMore) {
                        emptyState.classList.remove('hidden');
                    } else {
                        emptyState.classList.add('hidden');
                        data.comments.forEach(comment => {
                            container.insertAdjacentHTML('beforeend', renderCommentItem(comment));
                        });
                        if (data.hasMore) {
                            loadMoreBtn.classList.remove('hidden');
                            state.page++;
                        } else {
                            loadMoreBtn.classList.add('hidden');
                        }
                    }
                } catch (err) {
                    console.error('Error loading comments:', err);
                } finally {
                    state.loading = false;
                }
            }

            function renderCommentItem(comment, isReply = false) {
                const timeAgo = formatTimeAgo(comment.created_at);

                const getReactionBtnContent = (userReaction) => {
                    const emojiMap = {
                        like: { icon: '<span class="material-symbols-outlined fill-current text-primary">thumb_up</span>', label: 'Like', color: 'text-primary' },
                        love: { icon: '<span class="text-[20px]">❤️</span>', label: 'Love', color: 'text-red-500' },
                        haha: { icon: '<span class="text-[20px]">😂</span>', label: 'Haha', color: 'text-yellow-500' },
                        wow: { icon: '<span class="text-[20px]">😮</span>', label: 'Wow', color: 'text-yellow-500' },
                        sad: { icon: '<span class="text-[20px]">😢</span>', label: 'Sad', color: 'text-yellow-500' },
                        angry: { icon: '<span class="text-[20px]">😡</span>', label: 'Angry', color: 'text-orange-600' },
                        care: { icon: '<span class="text-[20px]">🥰</span>', label: 'Care', color: 'text-yellow-500' }
                    };
                    if (userReaction && emojiMap[userReaction]) {
                        const config = emojiMap[userReaction];
                        return `${config.icon}<span class="text-xs font-bold ${config.color}">${config.label}</span>`;
                    }
                    return '<span class="material-symbols-outlined text-[18px]">thumb_up</span><span class="text-xs font-bold group-hover:text-primary">Like</span>';
                };

                const reactionBtnContent = getReactionBtnContent(comment.userReaction);
                const reactionClass = comment.userReaction ? 'text-primary' : 'text-[#60758a] hover:text-primary';
                const displayHandle = comment.user_id.username || comment.user_id.fullName.replace(/\s+/g, '').toLowerCase();

                let breakdownHtml = '';
                if (comment.reactionCount > 0 && comment.reactionBreakdown) {
                    breakdownHtml = '<div class="flex -space-x-1 mr-1">';
                    const sortedTypes = Object.keys(comment.reactionBreakdown).sort((a, b) => comment.reactionBreakdown[b] - comment.reactionBreakdown[a]).slice(0, 3);
                    sortedTypes.forEach(type => {
                        const emoji = { like: '👍', love: '❤️', haha: '😂', wow: '😮', sad: '😢', angry: '😡', care: '🥰' }[type];
                        breakdownHtml += `<span class="size-3 flex items-center justify-center bg-white dark:bg-slate-800 rounded-full border border-gray-100 dark:border-slate-700 text-[10px]" title="${type}">${emoji}</span>`;
                    });
                    breakdownHtml += `</div><span class="total-count text-[10px]">${comment.reactionCount}</span>`;
                }

                return `
                    <div class="flex gap-3 ${isReply ? 'ml-12' : ''}" id="comment-${comment._id}">
                        <div class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-9 shrink-0" 
                            style='background-image: url("/uploads/${comment.user_id.profile_picture || "default-profile.png"}");'>
                        </div>
                        <div class="flex-1">
                            <div class="bg-[#f0f2f5] dark:bg-slate-800 rounded-2xl px-3 py-2 inline-block min-w-[200px]">
                                <div class="flex items-center justify-between gap-4">
                                    <span class="font-bold text-xs capitalize">${comment.user_id.fullName}</span>
                                    <span class="text-[10px] text-[#60758a]">${timeAgo}</span>
                                </div>
                                <p class="text-sm mt-0.5">
                                    ${comment.reply_to_user_id ? `<span class="text-primary font-medium">@${comment.reply_to_user_id.username || comment.reply_to_user_id.fullName.replace(/\s+/g, '').toLowerCase()}</span> ` : ''}
                                    ${comment.comment_text}
                                </p>
                                <div class="reaction-summary flex items-center gap-1 justify-end mt-1 h-4">
                                    ${breakdownHtml}
                                </div>
                            </div>
                            <div class="flex items-center gap-4 mt-1 px-2 relative">
                                <div class="relative reaction-container group" data-comment-id="${comment._id}">
                                    <button class="reaction-btn flex items-center gap-1 hover:bg-gray-100 dark:hover:bg-slate-700 px-2 py-1 rounded-full transition-colors ${reactionClass}">
                                        ${reactionBtnContent}
                                    </button>
                                    <div class="reaction-picker absolute bottom-full left-0 mb-2 bg-white dark:bg-slate-800 shadow-xl border border-gray-100 dark:border-slate-700 rounded-full px-2 py-1 flex gap-2 z-[100]">
                                        ${['like', 'love', 'care', 'haha', 'wow', 'sad', 'angry'].map(type => `
                                            <div class="relative group/emoji">
                                                <button class="reaction-emoji text-xl p-1 hover:scale-125 transition-transform" data-type="${type}">
                                                    ${{ like: '👍', love: '❤️', care: '🥰', haha: '😂', wow: '😮', sad: '😢', angry: '😡' }[type]}
                                                </button>
                                            </div>
                                        `).join('')}
                                    </div>
                                </div>
                                <button class="reply-btn text-xs font-bold text-[#60758a] hover:text-primary" 
                                    data-user="${displayHandle}" data-id="${comment.parent_comment_id || comment._id}">Reply</button>
                            </div>
                            <div class="replies-container mt-2">
                                ${comment.replies ? comment.replies.map(r => renderCommentItem(r, true)).join('') : ''}
                            </div>
                        </div>
                    </div>
                `;
            }

            // Delegated Reply Logic
            document.body.addEventListener('click', (e) => {
                const btn = e.target.closest('.reply-btn');
                if (!btn) return;

                const commentSection = btn.closest('.comments-section');
                if (!commentSection) return;

                const input = commentSection.querySelector('.comment-input');
                if (input) {
                    input.value = `@${btn.dataset.user} `;
                    input.dataset.parentId = btn.dataset.id;
                    input.focus();
                    input.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
            });

            // Comment Submission Logic
            document.body.addEventListener("click", async (e) => {
                const btn = e.target.closest(".submit-comment-btn");
                if (!btn) return;

                e.preventDefault();
                const commentSection = btn.closest(".comments-section");
                if (!commentSection) return;

                const postId = commentSection.dataset.postId;
                const textarea = commentSection.querySelector(".comment-input");
                const commentText = textarea.value.trim();
                const commentsContainer = commentSection.querySelector(".comments-container");
                const emptyMessage = commentSection.querySelector(".empty-comments");
                const parentId = textarea.dataset.parentId || null;

                if (!commentText) return;

                try {
                    btn.disabled = true;
                    const res = await fetch(`/posts/${postId}/comments`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            comment_text: commentText,
                            parent_comment_id: parentId
                        })
                    });

                    if (res.ok) {
                        const data = await res.json();
                        if (data.success) {
                            const comment = data.comment;
                            if (parentId) {
                                const parentComment = commentSection.querySelector(`#comment-${parentId}`);
                                if (parentComment) {
                                    const repliesContainer = parentComment.querySelector('.replies-container');
                                    repliesContainer.insertAdjacentHTML("beforeend", renderCommentItem(comment, true));
                                }
                            } else {
                                commentsContainer.insertAdjacentHTML("afterbegin", renderCommentItem(comment, false));
                                emptyMessage.classList.add("hidden");
                            }
                            textarea.value = "";
                            delete textarea.dataset.parentId;
                        }
                    }
                } catch (err) {
                    console.error("Submission error:", err);
                } finally {
                    btn.disabled = false;
                }
            });

            // Delegated Reaction Logic
            document.body.addEventListener('click', (e) => {
                const btn = e.target.closest('.reaction-btn');
                if (!btn) return;
                const container = btn.closest('.reaction-container');
                if (!container) return;

                const isReacted = btn.classList.contains('text-primary') || btn.querySelector('.text-[20px]');
                const labelEl = btn.querySelector('span:last-child');
                const currentLabel = labelEl ? labelEl.textContent.toLowerCase() : 'like';

                const postId = container.dataset.postId;
                const commentId = container.dataset.commentId;
                const id = postId || commentId;
                const type = postId ? 'post' : 'comment';

                handleReaction(id, type, isReacted ? currentLabel : 'like', container);
            });

            document.body.addEventListener('click', (e) => {
                const emojiBtn = e.target.closest('.reaction-emoji');
                if (!emojiBtn) return;
                const container = emojiBtn.closest('.reaction-container');
                if (!container) return;

                const postId = container.dataset.postId;
                const commentId = container.dataset.commentId;
                const id = postId || commentId;
                const type = postId ? 'post' : 'comment';

                handleReaction(id, type, emojiBtn.dataset.type, container);
                container.classList.remove('show-picker');
            });

            async function handleReaction(id, targetType, reactionType, container) {
                try {
                    const endpoint = targetType === 'post' ? `/posts/${id}/react` : `/comments/${id}/react`;
                    const response = await fetch(endpoint, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ reaction_type: reactionType })
                    });

                    if (response.ok) {
                        const data = await response.json();
                        updateReactionUI(container, data);
                    }
                } catch (err) {
                    console.error('Reaction error:', err);
                }
            }

            function updateReactionUI(container, data) {
                const btn = container.querySelector('.reaction-btn');
                let summary = container.querySelector('.reaction-summary');
                if (!summary) {
                    if (container.parentElement && container.parentElement.querySelector('.reaction-summary')) {
                        summary = container.parentElement.querySelector('.reaction-summary');
                    } else {
                        const commentItem = container.closest('[id^="comment-"]');
                        if (commentItem) summary = commentItem.querySelector('.reaction-summary');
                    }
                }

                if (data.userReaction) {
                    const type = data.userReaction;
                    const emojiMap = {
                        like: { icon: '<span class="material-symbols-outlined fill-current text-primary">thumb_up</span>', label: 'Like', color: 'text-primary' },
                        love: { icon: '<span class="text-[20px]">❤️</span>', label: 'Love', color: 'text-red-500' },
                        haha: { icon: '<span class="text-[20px]">😂</span>', label: 'Haha', color: 'text-yellow-500' },
                        wow: { icon: '<span class="text-[20px]">😮</span>', label: 'Wow', color: 'text-yellow-500' },
                        sad: { icon: '<span class="text-[20px]">😢</span>', label: 'Sad', color: 'text-yellow-500' },
                        angry: { icon: '<span class="text-[20px]">😡</span>', label: 'Angry', color: 'text-orange-600' },
                        care: { icon: '<span class="text-[20px]">🥰</span>', label: 'Care', color: 'text-yellow-500' }
                    };
                    const config = emojiMap[type];
                    btn.innerHTML = `${config.icon}<span class="text-xs font-bold ${config.color}">${config.label}</span>`;
                } else {
                    btn.innerHTML = '<span class="material-symbols-outlined text-[18px]">thumb_up</span><span class="text-xs font-bold group-hover:text-primary">Like</span>';
                }

                if (data.reactionCount > 0 && summary) {
                    let breakdownHtml = '<div class="flex -space-x-1 mr-1">';
                    const sortedTypes = Object.keys(data.reactionBreakdown).sort((a, b) => data.reactionBreakdown[b] - data.reactionBreakdown[a]).slice(0, 3);
                    sortedTypes.forEach(type => {
                        const emoji = { like: '👍', love: '❤️', haha: '😂', wow: '😮', sad: '😢', angry: '😡', care: '🥰' }[type];
                        const sizeClass = container.dataset.commentId ? 'size-3 text-[10px]' : 'size-4';
                        breakdownHtml += `<span class="${sizeClass} flex items-center justify-center bg-white dark:bg-slate-800 rounded-full border border-gray-100 dark:border-slate-700" title="${type}">${emoji}</span>`;
                    });
                    breakdownHtml += `</div><span class="total-count ${container.dataset.commentId ? 'text-[10px]' : ''}">${data.reactionCount}</span>`;
                    summary.innerHTML = breakdownHtml;
                } else if (summary) {
                    summary.innerHTML = '';
                }
            }

            initCommentToggles();
        </script>
        <script>
            const notiBtn = document.getElementById('noti-btn');
            const notiBtnMobile = document.getElementById('noti-btn-mobile');
            const notiSidebar = document.getElementById('notifications-sidebar');
            const notiOverlay = document.getElementById('notifications-overlay');
            const closeNoti = document.getElementById('close-noti');
            const list = document.getElementById('sidebar-notifications-list');
            const badgeHeader = document.getElementById('header-noti-badge');
            const badgeSidebar = document.getElementById('sidebar-noti-count');
            const markAllBtn = document.getElementById('mark-all-read-btn');

            async function loadSidebarNotifications() {
                try {
                    const res = await fetch('/notifications/sidebar');
                    const data = await res.json();

                    if (!data.success) return;

                    list.innerHTML = '';

                    if (badgeSidebar) {
                        badgeSidebar.textContent = data.unreadCount;
                        badgeSidebar.classList.toggle('hidden', data.unreadCount === 0);
                    }
                    if (badgeHeader) {
                        badgeHeader.classList.toggle('hidden', data.unreadCount === 0);
                    }

                    if (data.notifications.length === 0) {
                        list.innerHTML = '<div class="p-8 text-center opacity-50 text-sm">No notifications yet</div>';
                        return;
                    }

                    data.notifications.forEach(notif => {
                        const unreadDot = notif.read ? '' : `
                        <div class="absolute right-4 top-1/2 -translate-y-1/2 size-2.5 bg-primary rounded-full"></div>
                    `;

                        list.innerHTML += `
                    <div class="p-4 hover:bg-[#f0f2f5] dark:hover:bg-[#2d3a48] cursor-pointer flex gap-3 relative border-b border-[#f0f2f5]/50 dark:border-[#2d3a48]/50 transition-colors">
                        ${unreadDot}
                        <div class="size-12 rounded-full bg-cover bg-center shrink-0"
                            style="background-image:url('/uploads/${notif.sender_id?.profile_picture || 'default-profile.png'}')">
                        </div>
                        <div class="flex-1 pr-4">
                            <p class="text-sm text-[#111418] dark:text-white">
                                <span class="font-bold">${notif.sender_id?.fullName || 'Someone'}</span>
                                ${notif.message}
                            </p>
                            <p class="text-xs text-primary font-bold mt-1">
                                ${formatTimeAgo(notif.created_at)}
                            </p>
                        </div>
                    </div>`;
                    });

                } catch (err) {
                    console.error(err);
                }
            }

            function formatTimeAgo(date) {
                const seconds = Math.floor((new Date() - new Date(date)) / 1000);
                if (seconds < 60) return 'just now';
                const minutes = Math.floor(seconds / 60);
                if (minutes < 60) return `${minutes}m ago`;
                const hours = Math.floor(minutes / 60);
                if (hours < 24) return `${hours}h ago`;
                return `${Math.floor(hours / 24)}d ago`;
            }

            function toggleNoti(show) {
                if (show) {
                    loadSidebarNotifications();
                    notiOverlay.classList.remove('hidden');
                    setTimeout(() => {
                        notiSidebar.classList.remove('translate-x-full');
                    }, 10);
                    document.body.classList.add('overflow-hidden');
                } else {
                    notiSidebar.classList.add('translate-x-full');
                    setTimeout(() => {
                        notiOverlay.classList.add('hidden');
                    }, 300);
                    document.body.classList.remove('overflow-hidden');
                }
            }

            if (notiBtn) notiBtn.addEventListener('click', () => toggleNoti(true));
            if (notiBtnMobile) notiBtnMobile.addEventListener('click', () => toggleNoti(true));
            if (closeNoti) closeNoti.addEventListener('click', () => toggleNoti(false));

            markAllBtn?.addEventListener('click', async () => {
                try {
                    const res = await fetch('/notifications/mark-all-read', { method: 'POST' });
                    const data = await res.json();
                    if (data.success) {
                        loadSidebarNotifications();
                    }
                } catch (err) {
                    console.error(err);
                }
            });

            // Initial check for unread count
            window.addEventListener('load', async () => {
                try {
                    const res = await fetch('/notifications/sidebar');
                    const data = await res.json();
                    if (data.success && data.unreadCount > 0) {
                        if (badgeHeader) badgeHeader.classList.remove('hidden');
                    }
                } catch (err) { }
            });

            // Profile Picture Upload Logic
            const profilePicInput = document.getElementById('profilePicInput');
            const profilePicDisplay = document.getElementById('profilePicDisplay');
            const profileActionBtns = document.getElementById('profileActionBtns');
            const saveProfilePic = document.getElementById('saveProfilePic');
            const cancelProfilePic = document.getElementById('cancelProfilePic');
            const profilePicLoader = document.getElementById('profilePicLoader');
            let originalProfilePicSet = profilePicDisplay?.style.backgroundImage;

            if (profilePicInput) {
                profilePicInput.addEventListener('change', function () {
                    const file = this.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            if (profilePicDisplay) profilePicDisplay.style.backgroundImage = `url("${e.target.result}")`;
                            if (profileActionBtns) profileActionBtns.classList.remove('hidden');
                        }
                        reader.readAsDataURL(file);
                    }
                });
            }

            if (cancelProfilePic) {
                cancelProfilePic.addEventListener('click', () => {
                    if (profilePicInput) profilePicInput.value = '';
                    if (profilePicDisplay) profilePicDisplay.style.backgroundImage = originalProfilePicSet;
                    if (profileActionBtns) profileActionBtns.classList.add('hidden');
                });
            }

            if (saveProfilePic) {
                saveProfilePic.addEventListener('click', async () => {
                    if (!profilePicInput) return;
                    const file = profilePicInput.files[0];
                    if (!file) return;

                    const formData = new FormData();
                    formData.append('profile_picture', file);

                    try {
                        if (profilePicLoader) profilePicLoader.classList.remove('hidden');
                        if (profileActionBtns) profileActionBtns.classList.add('hidden');

                        const response = await fetch('/profile/edit', {
                            method: 'POST',
                            headers: {
                                'Accept': 'application/json'
                            },
                            body: formData
                        });

                        const contentType = response.headers.get("content-type");
                        if (contentType && contentType.indexOf("application/json") !== -1) {
                            const data = await response.json();
                            if (data.success) {
                                originalProfilePicSet = `url("/uploads/${data.user.profile_picture}")`;
                                if (profilePicDisplay) profilePicDisplay.style.backgroundImage = originalProfilePicSet;
                                // Update all other instances of user's profile picture on the page
                                document.querySelectorAll('[data-alt="Your profile avatar"], [data-alt="User profile avatar thumbnail"]').forEach(el => {
                                    el.style.backgroundImage = originalProfilePicSet;
                                });
                                // Reload to show the new automated post in feed
                                setTimeout(() => window.location.reload(), 500);
                            } else {
                                alert(data.message || 'Failed to update profile picture');
                                cancelProfilePic.click();
                            }
                        } else {
                            // If not JSON, it's likely an HTML error page (404 or redirect)
                            if (response.status === 404) {
                                alert('Error: Server route not found (404). PLEASE RESTART YOUR BACKEND SERVER to apply the new routes.');
                            } else {
                                const text = await response.text();
                                alert('Error: Received non-JSON response. Check console.');
                                console.error('Response body:', text);
                            }
                            cancelProfilePic.click();
                        }
                    } catch (err) {
                        console.error('Error uploading profile picture:', err);
                        alert('Error uploading profile picture: ' + err.message);
                        cancelProfilePic.click();
                    }
                    finally {
                        if (profilePicLoader) profilePicLoader.classList.add('hidden');
                    }
                });
            }

            // Cover Photo Upload Logic
            const coverPhotoInput = document.getElementById('coverPhotoInput');
            const coverPhotoDisplay = document.getElementById('coverPhotoDisplay');
            const coverActionBtns = document.getElementById('coverActionBtns');
            const saveCoverPhoto = document.getElementById('saveCoverPhoto');
            const cancelCoverPhoto = document.getElementById('cancelCoverPhoto');
            const coverPhotoLoader = document.getElementById('coverPhotoLoader');
            let originalCoverPhotoSet = coverPhotoDisplay?.style.backgroundImage;

            if (coverPhotoInput) {
                coverPhotoInput.addEventListener('change', function () {
                    const file = this.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            if (coverPhotoDisplay) coverPhotoDisplay.style.backgroundImage = `url("${e.target.result}")`;
                            if (coverActionBtns) coverActionBtns.classList.remove('hidden');
                        }
                        reader.readAsDataURL(file);
                    }
                });
            }

            if (cancelCoverPhoto) {
                cancelCoverPhoto.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (coverPhotoInput) coverPhotoInput.value = '';
                    if (coverPhotoDisplay) coverPhotoDisplay.style.backgroundImage = originalCoverPhotoSet;
                    if (coverActionBtns) coverActionBtns.classList.add('hidden');
                });
            }

            if (saveCoverPhoto) {
                saveCoverPhoto.addEventListener('click', async (e) => {
                    e.stopPropagation();
                    if (!coverPhotoInput) return;
                    const file = coverPhotoInput.files[0];
                    if (!file) return;

                    const formData = new FormData();
                    formData.append('cover_photo', file);

                    try {
                        if (coverPhotoLoader) coverPhotoLoader.classList.remove('hidden');
                        if (coverActionBtns) coverActionBtns.classList.add('hidden');

                        const response = await fetch('/profile/edit', {
                            method: 'POST',
                            headers: {
                                'Accept': 'application/json'
                            },
                            body: formData
                        });

                        const data = await response.json();
                        if (data.success) {
                            originalCoverPhotoSet = `url("/uploads/${data.user.cover_photo}")`;
                            if (coverPhotoDisplay) coverPhotoDisplay.style.backgroundImage = originalCoverPhotoSet;
                            // Reload to show the new automated post in feed
                            setTimeout(() => window.location.reload(), 500);
                        } else {
                            alert(data.message || 'Failed to update cover photo');
                            cancelCoverPhoto.click();
                        }
                    } catch (err) {
                        console.error('Error uploading cover photo:', err);
                        alert('Error uploading cover photo: ' + err.message);
                        cancelCoverPhoto.click();
                    }
                    finally {
                        if (coverPhotoLoader) coverPhotoLoader.classList.add('hidden');
                    }
                });
            }

            // Edit Details Form Handling
            const editDetailsForm = document.getElementById('editDetailsForm');
            if (editDetailsForm) {
                editDetailsForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const formData = new FormData(editDetailsForm);
                    const data = Object.fromEntries(formData.entries());

                    try {
                        const response = await fetch('/profile/edit', {
                            method: 'POST',
                            headers: {
                                'Accept': 'application/json'
                            },
                            body: formData
                        });

                        const result = await response.json();
                        if (result.success) {
                            window.location.reload();
                        } else {
                            alert(result.message || 'Failed to update details');
                        }
                    } catch (err) {
                        console.error('Error updating details:', err);
                        alert('Error updating details');
                    }
                });
            }
        </script>
</body>

</html>
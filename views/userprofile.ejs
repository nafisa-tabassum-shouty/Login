<!DOCTYPE html>

<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>User Profile | SocialCircle</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap"
        rel="stylesheet" />
    <!-- Material Symbols -->
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#258cf4",
                        "background-light": "#f5f7f8",
                        "background-dark": "#101922",
                    },
                    fontFamily: {
                        "display": ["Plus Jakarta Sans"]
                    },
                    borderRadius: { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" },
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        body {
            font-family: "Plus Jakarta Sans", sans-serif;
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        #notifications-sidebar {
            transition: transform 0.3s ease-in-out;
        }
    </style>
</head>

<body class="bg-background-light dark:bg-background-dark text-[#111418] dark:text-white min-h-screen">
    <div class="layout-container flex flex-col items-center">
        <!-- Top Navigation Bar -->
        <header
            class="w-full bg-white dark:bg-[#1a242d] border-b border-solid border-[#f0f2f5] dark:border-[#2d3a48] px-4 md:px-10 py-3 sticky top-0 z-50">
            <div class="max-w-[1200px] mx-auto flex items-center justify-between">
                <div class="flex items-center gap-8">
                    <a href="/dashboard"
                        class="flex items-center gap-4 text-[#111418] dark:text-white hover:opacity-80 transition-opacity">
                        <div class="size-6 text-primary">
                            <svg fill="currentColor" viewbox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                                <path
                                    d="M44 11.2727C44 14.0109 39.8386 16.3957 33.69 17.6364C39.8386 18.877 44 21.2618 44 24C44 26.7382 39.8386 29.123 33.69 30.3636C39.8386 31.6043 44 33.9891 44 36.7273C44 40.7439 35.0457 44 24 44C12.9543 44 4 40.7439 4 36.7273C4 33.9891 8.16144 31.6043 14.31 30.3636C8.16144 29.123 4 26.7382 4 24C4 21.2618 8.16144 18.877 14.31 17.6364C8.16144 16.3957 4 14.0109 4 11.2727C4 7.25611 12.9543 4 24 4C35.0457 4 44 7.25611 44 11.2727Z">
                                </path>
                            </svg>
                        </div>
                        <h2 class="text-lg font-extrabold leading-tight tracking-tight">SocialCircle</h2>
                    </a>
                    <label class="hidden lg:flex flex-col min-w-40 h-10 max-w-64">
                        <div class="flex w-full flex-1 items-stretch rounded-lg h-full">
                            <div
                                class="text-[#60758a] flex border-none bg-[#f0f2f5] dark:bg-[#2d3a48] items-center justify-center pl-4 rounded-l-lg">
                                <span class="material-symbols-outlined text-xl">search</span>
                            </div>
                            <input
                                class="form-input flex w-full min-w-0 flex-1 border-none bg-[#f0f2f5] dark:bg-[#2d3a48] dark:text-white h-full placeholder:text-[#60758a] px-4 rounded-r-lg text-sm font-normal focus:ring-0"
                                placeholder="Search" value="" />
                        </div>
                    </label>
                </div>
                <div class="flex flex-1 justify-end gap-6 items-center">
                    <nav class="hidden md:flex items-center gap-6">
                        <a class="text-sm font-semibold text-primary transition-colors hover:text-blue-600"
                            href="/dashboard">Home</a>
                        <a class="text-sm font-semibold hover:text-primary transition-colors" href="#">Explore</a>
                        <button id="noti-btn"
                            class="text-sm font-semibold hover:text-primary transition-colors flex items-center gap-1">
                            Notifications
                            <span class="size-2 bg-red-500 rounded-full"></span>
                        </button>
                    </nav>
                    <div class="flex gap-2">
                        <button
                            class="flex items-center justify-center rounded-lg h-10 w-10 bg-[#f0f2f5] dark:bg-[#2d3a48] text-[#111418] dark:text-white">
                            <span class="material-symbols-outlined">settings</span>
                        </button>
                    </div>
                    <div class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-10 border-2 border-primary"
                        data-alt="User profile avatar thumbnail"
                        style='background-image: url("/uploads/<%= user.profile_picture || "default-profile.png" %>");'>
                    </div>
                </div>
            </div>
        </header>
        <!-- Main Content Area -->
        <main class="w-full max-w-[1100px] flex-1 py-4 md:py-8 px-4">
            <!-- Header Section: Cover + Profile Info -->
            <div
                class="bg-white dark:bg-[#1a242d] rounded-xl overflow-hidden shadow-sm border border-[#f0f2f5] dark:border-[#2d3a48]">
                <!-- Cover Image -->
                <div class="relative h-48 md:h-80 w-full bg-cover bg-center"
                    data-alt="Wide landscape cinematic cover photo"
                    style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuAFaFHmuRiqwCazvTWYA-RspagsXfEi3DbF9FKZq88RhA-hQmriMzqrq3lJ2tcGRDF3UARTNoJo4EvAm9npzmcV5OOz5r1ks2Mz9J4YHHfgWCLdsx5er8jzOlqVysT-t8vDd2Okrd0hiy4f89N3ox4Byt_YLddcS6TMCO137ApRnOVUOYaE-rKxSP7eeWIbDAuVWMyXUgZlc0BUPxWqB0TV4WL48PLf52YbNLQaz7NAXyn6RhMvvvt1dF4_MPh_SrURAeJoceoNGZA");'>
                </div>
                <!-- Profile Identity -->
                <div class="px-6 pb-6 relative">
                    <div class="flex flex-col md:flex-row items-end md:items-center gap-4 -mt-16 md:-mt-20">
                        <div
                            class="size-32 md:size-40 rounded-full border-4 border-white dark:border-[#1a242d] overflow-hidden bg-white shadow-lg">
                            <div class="w-full h-full bg-cover bg-center" data-alt="Large circular user profile picture"
                                style='background-image: url("/uploads/<%= user.profile_picture || "default-profile.png" %>");'>
                            </div>
                        </div>
                        <div class="flex-1 pt-2 md:pt-16">
                            <div class="flex flex-col md:flex-row md:items-center justify-between w-full">
                                <div>
                                    <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight">
                                        <%= user.fullName %> <span
                                                class="material-symbols-outlined text-primary text-xl align-middle">verified</span>
                                    </h1>
                                    <p class="text-[#60758a] dark:text-gray-400 font-medium">@<%= user.username ||
                                            user.fullName.toLowerCase().replace(/\s+/g, '_' ) %>
                                    </p>
                                </div>
                                <div class="flex gap-3 mt-4 md:mt-0">
                                    <a href="/profile/edit"
                                        class="flex-1 md:flex-none px-6 py-2 bg-primary text-white font-bold rounded-lg hover:bg-blue-600 transition-colors text-center">
                                        Edit Profile
                                    </a>
                                    <button
                                        class="flex-1 md:flex-none px-6 py-2 bg-[#f0f2f5] dark:bg-[#2d3a48] text-[#111418] dark:text-white font-bold rounded-lg">
                                        Add Story
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Profile Tabs -->
                <div class="border-t border-[#f0f2f5] dark:border-[#2d3a48] px-6">
                    <div class="flex gap-8 overflow-x-auto no-scrollbar">
                        <a class="border-b-[3px] border-primary py-4 px-2 text-sm font-bold text-primary"
                            href="#">Posts</a>
                        <a class="border-b-[3px] border-transparent py-4 px-2 text-sm font-bold text-[#60758a] hover:text-[#111418] dark:hover:text-white transition-colors"
                            href="#">About</a>
                        <a class="border-b-[3px] border-transparent py-4 px-2 text-sm font-bold text-[#60758a] hover:text-[#111418] dark:hover:text-white transition-colors"
                            href="#">Friends</a>
                        <a class="border-b-[3px] border-transparent py-4 px-2 text-sm font-bold text-[#60758a] hover:text-[#111418] dark:hover:text-white transition-colors"
                            href="#">Photos</a>
                        <a class="border-b-[3px] border-transparent py-4 px-2 text-sm font-bold text-[#60758a] hover:text-[#111418] dark:hover:text-white transition-colors"
                            href="#">More</a>
                    </div>
                </div>
            </div>
            <!-- Two-Column Layout -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mt-6">
                <!-- Left Column: About/Info -->
                <div class="lg:col-span-4 space-y-6">
                    <section
                        class="bg-white dark:bg-[#1a242d] p-6 rounded-xl shadow-sm border border-[#f0f2f5] dark:border-[#2d3a48]">
                        <h3 class="text-xl font-bold mb-4">Intro</h3>
                        <p class="text-sm leading-relaxed text-[#111418] dark:text-gray-300 mb-6">
                            Product Designer &amp; Photography Enthusiast based in San Francisco. I build digital
                            experiences and capture moments in between. 🎨📸
                        </p>
                        <div class="space-y-4">
                            <div class="flex items-center gap-3 text-sm text-[#60758a] dark:text-gray-400">
                                <span class="material-symbols-outlined">work</span>
                                <span>Senior Designer at <strong class="text-[#111418] dark:text-white">Studio
                                        Alpha</strong></span>
                            </div>
                            <div class="flex items-center gap-3 text-sm text-[#60758a] dark:text-gray-400">
                                <span class="material-symbols-outlined">school</span>
                                <span>Studied at <strong class="text-[#111418] dark:text-white">Rhode Island School of
                                        Design</strong></span>
                            </div>
                            <div class="flex items-center gap-3 text-sm text-[#60758a] dark:text-gray-400">
                                <span class="material-symbols-outlined">home</span>
                                <span>Lives in <strong class="text-[#111418] dark:text-white">San Francisco,
                                        CA</strong></span>
                            </div>
                            <div class="flex items-center gap-3 text-sm text-[#60758a] dark:text-gray-400">
                                <span class="material-symbols-outlined">calendar_month</span>
                                <span>Joined <strong class="text-[#111418] dark:text-white">March 2018</strong></span>
                            </div>
                        </div>
                        <button
                            class="w-full mt-6 py-2 bg-[#f0f2f5] dark:bg-[#2d3a48] font-bold rounded-lg hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
                            Edit Details
                        </button>
                    </section>
                    <!-- Photos Grid Preview -->
                    <section
                        class="bg-white dark:bg-[#1a242d] p-6 rounded-xl shadow-sm border border-[#f0f2f5] dark:border-[#2d3a48]">
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="text-xl font-bold">Photos</h3>
                            <a class="text-primary text-sm font-semibold" href="#">See All</a>
                        </div>
                        <div class="grid grid-cols-3 gap-2">
                            <div class="aspect-square bg-cover bg-center rounded-lg"
                                data-alt="Modern architecture photo"
                                style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuBLe2bZwWtTGBJ-iua2JIVTQhAp7sZ22woHEfsYSeCbMmFCipMGNikPJ2Lgc5mGnkeWFRrlpdGAHScJlGI0idUPgqHtH_0OMNt3aKtHs31YEtPZhlaeghcvH2VHnXmG_RukbWqjkoC8E240p7uARny1IienJbOOMamRi6LiOGMFqq3TJxdfetrP90qMFhaKSkupuH6oH8tPPbiSV1-7ifRGG89edcJgOWvZKw1FS0Axzw7eOwjydsHSQG1xYmKtscHe_vY3a754KwM");'>
                            </div>
                            <div class="aspect-square bg-cover bg-center rounded-lg" data-alt="Sunset landscape photo"
                                style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuD9VumSqbXRuuDTfMEFRYk8zOoh1RT2_AcVhfUS-BsUN1n2GcaVfArOLD-lCmG5OvSYmSWsLi5fIEXld-EWDGAJskOJtWig1c98FfG6QQzpl1bVbBaCkCNfQaKRQgLlxZb96uimWe4X2ihIIq4L2bxOvX2lYpb_RIl3T5xC__NJiFuItaS7NxtL0soKT0h1pSroWW6iXXgxK4uzhU_wQWUwXsFDrL6dwKjlS16FH9EWqys7q4pVZKxCcrNfJeBDlGNeVc3PixFgfHs");'>
                            </div>
                            <div class="aspect-square bg-cover bg-center rounded-lg"
                                data-alt="Cozy interior office space"
                                style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuAt7G4TKFqgsEDoTW5Zkzp6E5x5FLGFIMZYtwpC9tE3ISCjaK3jdJxb3CvWmo0ZWGpSKxAjR3CegffYShj9bgh7yV_K5-GghiVZQu-VKb7j6m_WFvUmuJLzMEuewEbk14Hy0S2S8PV9kosHyGmZ9XdGTWPJhuv-qn63nJ_zslDl_3QrCzQOJN6kM8DCPiJ8-xQg_juFhc0q-lxeZwe840vOtyd5kBr3LBiqIueJ55iZU_J8MLp79XXR3-tWdzTll-zSINSiCwgXeRs");'>
                            </div>
                            <div class="aspect-square bg-cover bg-center rounded-lg" data-alt="Mountain range view"
                                style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuDS8GsmlW_haX4poDsTk-hjaYaVl4osiWnacNebeMbeQlTbeo3iQlc_D66SMSLBElW9ce9GV4b3nNAjgFOI2OZaE1VNY-4bkQY8yk5jzxYo8aO_hHwTrftA8K593MiO6gN3I_rR0RMxZG2GVh0SSgLcyzG0_vQzYFpmvCUJWH4mmrBqu9cZ-3m5x3AhwrKEquHf1PbsANyfbRH6x5t-M1B80sfnSfoHzWlGYL2BozqTp4oNQoDi8-rhOoKBmA0qI1A5Y3eIji1JvuA");'>
                            </div>
                            <div class="aspect-square bg-cover bg-center rounded-lg" data-alt="Forest greenery"
                                style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuAFaUcXClsjF4Hj0qHNvF7_i1eGi50LsXkdNrX3h2k7ZS-muPVzFcFB6PA7SZ_nZSyDIUT1v9vgs98bNtXsQpDsZZmwEWNnrE4Y7EJ6VRiCGSGKVI29rSMYbMDKMp10ysJU7svwTPRmIRS9xKdlXDDIG34buI3qHQJ4U2YdikAFpCkvyBzrJ8W-FWHDIQaybNDm76hkQun9j_swmhpQfJYaJQ5L48cdZuQ1wBs-fpGdIn9uovW4CugMBkhJBjVfViPVSTIoNWdIEqc");'>
                            </div>
                            <div class="aspect-square bg-cover bg-center rounded-lg" data-alt="Abstract art painting"
                                style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuBXdKrSx_hJ1Plgex8BQuHT_SkScEq9jgGmnx8jusilYPUgOTnsAKeDn1F5fuPV2lTYGjET3QX1Ujv2Ll77H9X4MMUs_2NTzq-w8Mk4HEqfbr5nL2XwMG6M16noRmnxqG81bj9ECnqluFgI6ecS-F6dJTNlHlrCEW6aWexUB1DuOTdbLrCVOWOj1SvHLa7jpK8S-9ro-704vvvQ-JTp6y4QU21ZKTWv18r9RexGQG58PXQUdLsOG0wcg1Ccaif9tn4LendvgzQ3oGg");'>
                            </div>
                        </div>
                    </section>
                </div>
                <!-- Right Column: Posts Feed -->
                <div class="lg:col-span-8 space-y-6">
                    <!-- Create Post Placeholder -->
                    <div
                        class="bg-white dark:bg-[#1a242d] p-6 rounded-xl shadow-sm border border-[#f0f2f5] dark:border-[#2d3a48]">
                        <div class="flex gap-4">
                            <div class="size-10 rounded-full bg-cover bg-center" data-alt="User small avatar"
                                style='background-image: url("/uploads/<%= user.profile_picture || "default-profile.png" %>");'>
                            </div>
                            <button
                                class="flex-1 bg-[#f0f2f5] dark:bg-[#2d3a48] rounded-full text-left px-5 text-[#60758a] dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
                                What's on your mind, <%= user.fullName.split(' ')[0] %>?
                            </button>
                        </div>
                        <div
                            class="border-t border-[#f0f2f5] dark:border-[#2d3a48] mt-4 pt-4 flex justify-between px-2">
                            <button
                                class="flex items-center gap-2 font-semibold text-[#60758a] dark:text-gray-400 hover:bg-[#f0f2f5] dark:hover:bg-[#2d3a48] p-2 rounded-lg transition-colors">
                                <span class="material-symbols-outlined text-red-500">videocam</span>
                                Live Video
                            </button>
                            <button
                                class="flex items-center gap-2 font-semibold text-[#60758a] dark:text-gray-400 hover:bg-[#f0f2f5] dark:hover:bg-[#2d3a48] p-2 rounded-lg transition-colors">
                                <span class="material-symbols-outlined text-green-500">photo_library</span>
                                Photo/Video
                            </button>
                            <button
                                class="flex items-center gap-2 font-semibold text-[#60758a] dark:text-gray-400 hover:bg-[#f0f2f5] dark:hover:bg-[#2d3a48] p-2 rounded-lg transition-colors">
                                <span class="material-symbols-outlined text-yellow-500">sentiment_satisfied</span>
                                Activity
                            </button>
                        </div>
                    </div>
                    <!-- Post Feed Sort -->
                    <div class="flex justify-between items-center px-2">
                        <h3 class="text-xl font-bold">Posts</h3>
                        <button
                            class="flex items-center gap-1 bg-white dark:bg-[#1a242d] px-3 py-1.5 rounded-lg border border-[#f0f2f5] dark:border-[#2d3a48] text-sm font-bold">
                            <span class="material-symbols-outlined text-base">tune</span>
                            Filters
                        </button>
                    </div>
                    <% if (posts && posts.length > 0) { %>
                        <% posts.forEach(post => { %>
                            <div class="bg-white dark:bg-[#1a242d] rounded-xl shadow-sm border border-[#f0f2f5] dark:border-[#2d3a48] mb-6">
                                <div class="p-4 flex justify-between items-center">
                                    <div class="flex gap-3">
                                        <div class="size-10 rounded-full bg-cover bg-center" data-alt="User avatar"
                                            style=' background-image: url("/uploads/<%=post.user_id.profile_picture
                                    || "default-profile.png" %>");'>
                        </div>
                        <div>
                            <p class="font-bold">
                                <%= post.user_id.fullName %>
                            </p>
                            <p class="text-xs text-[#60758a] dark:text-gray-400">
                                <%= new Date(post.created_at).toLocaleDateString() %> • <span
                                        class="material-symbols-outlined text-[10px] align-middle">public</span>
                            </p>
                        </div>
                    </div>
                    <button class="p-2 hover:bg-[#f0f2f5] dark:hover:bg-[#2d3a48] rounded-full">
                        <span class="material-symbols-outlined">more_horiz</span>
                    </button>
                </div>
                <div class="px-4 pb-3">
                    <p class="text-sm">
                        <%= post.content_text %>
                    </p>
                </div>
                <% if (post.content_image) { %>
                    <div class="h-[400px] w-full bg-cover bg-center"
                        style='background-image: url("/uploads/<%= post.content_image %>");'>
                    </div>
                    <% } %>
                        <% if (post.content_gif) { %>
                            <div class="w-full">
                                <img src="<%= post.content_gif %>" alt="GIF" class="w-full">
                            </div>
                            <% } %>
                                <div class="p-3">
                                    <div
                                        class="flex justify-between text-sm text-[#60758a] dark:text-gray-400 mb-3 px-1">
                                        <div class="flex items-center gap-1">
                                            <span
                                                class="flex items-center justify-center size-5 bg-primary rounded-full text-white text-[10px]"><span
                                                    class="material-symbols-outlined text-[12px] fill-1">thumb_up</span></span>
                                            <span>
                                                <%= post.reactionCount %>
                                            </span>
                                        </div>
                                        <span>
                                            <%= post.commentCount || 0 %> comments
                                        </span>
                                    </div>
                                    <div
                                        class="border-t border-[#f0f2f5] dark:border-[#2d3a48] pt-1 flex justify-between">
                                        <button
                                            class="flex-1 py-2 flex items-center justify-center gap-2 font-bold text-[#60758a] dark:text-gray-400 hover:bg-[#f0f2f5] dark:hover:bg-[#2d3a48] rounded-lg transition-colors">
                                            <span class="material-symbols-outlined">thumb_up</span>
                                            Like
                                        </button>
                                        <button
                                            class="flex-1 py-2 flex items-center justify-center gap-2 font-bold text-[#60758a] dark:text-gray-400 hover:bg-[#f0f2f5] dark:hover:bg-[#2d3a48] rounded-lg transition-colors">
                                            <span class="material-symbols-outlined">chat_bubble</span>
                                            Comment
                                        </button>
                                        <button
                                            class="flex-1 py-2 flex items-center justify-center gap-2 font-bold text-[#60758a] dark:text-gray-400 hover:bg-[#f0f2f5] dark:hover:bg-[#2d3a48] rounded-lg transition-colors">
                                            <span class="material-symbols-outlined">share</span>
                                            Share
                                        </button>
                                    </div>
                                </div>
            </div>
            <% }) %>
                <% } else { %>
                    <div class="text-center py-10 opacity-50">
                        <span class="material-symbols-outlined text-6xl mb-4">post_add</span>
                        <p>No posts yet. Start by creating your first post!</p>
                    </div>
                    <% } %>
    </div>
    </div>
    </main>
    <!-- Mobile Bottom Nav (visible on small screens) -->
    <div
        class="fixed bottom-0 w-full bg-white dark:bg-[#1a242d] border-t border-[#f0f2f5] dark:border-[#2d3a48] flex justify-around py-3 md:hidden z-50">
        <a href="/dashboard" class="text-primary"><span class="material-symbols-outlined">home</span></a>
        <button class="text-[#60758a] dark:text-gray-400"><span
                class="material-symbols-outlined">explore</span></button>
        <button class="text-[#60758a] dark:text-gray-400"><span
                class="material-symbols-outlined">add_box</span></button>
        <button id="noti-btn-mobile" class="text-[#60758a] dark:text-gray-400"><span
                class="material-symbols-outlined">notifications</span></button>
        <button class="text-[#60758a] dark:text-gray-400"><span class="material-symbols-outlined">person</span></button>
    </div>
    <!-- Notifications Sidebar Overlay -->
    <div id="notifications-overlay" class="fixed inset-0 z-[60] hidden">
        <div class="absolute inset-0 bg-black/30 backdrop-blur-sm" id="close-noti"></div>
        <aside
            class="absolute right-0 top-0 w-full max-w-[400px] bg-white dark:bg-[#1a242d] h-full shadow-2xl flex flex-col border-l border-[#f0f2f5] dark:border-[#2d3a48] translate-x-full"
            id="notifications-sidebar">
            <div class="p-4 border-b border-[#f0f2f5] dark:border-[#2d3a48] flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <h2 class="text-xl font-extrabold tracking-tight text-[#111418] dark:text-white">Notifications</h2>
                    <span class="bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full">3</span>
                </div>
                <button class="text-primary text-sm font-semibold hover:underline">Mark all as read</button>
            </div>
            <div class="flex-1 overflow-y-auto no-scrollbar">
                <div class="flex flex-col">
                    <div
                        class="p-4 hover:bg-[#f0f2f5] dark:hover:bg-[#2d3a48] cursor-pointer flex gap-3 group transition-colors relative border-b border-[#f0f2f5]/50 dark:border-[#2d3a48]/50">
                        <div class="absolute right-4 top-1/2 -translate-y-1/2 size-2.5 bg-primary rounded-full"></div>
                        <div class="size-12 rounded-full bg-cover bg-center shrink-0"
                            style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuB2rPwMNesUYqZJidYKNH5XlxsgOaEBw15ePeFJ2kmpylZoXSjKFq2ZQWV9dvH-lEnRUokMWJNQKAd5znkQqEhoKhvygNDLNMMoNjd0d0cbKy69-dggluygYTSrIOAXd1x3fuRHnDeZOILPdEX4zk4|  n0g2vb_BVViJ1NddIxH6ADznLjyek5zfGiTbms2UCqJXb9PELp39MMoweDbnQoI6e-1FggYIQ2L29-Grd5RYyGHrhCo29YbZtzXBGMe4JCg");'>
                        </div>
                        <div class="flex-1 pr-4">
                            <p class="text-sm text-[#111418] dark:text-white">
                                <span class="font-bold">Jordan Smith</span> liked your post: "Finally finished the
                                branding project..."
                            </p>
                            <p class="text-xs text-primary font-bold mt-1">2 mins ago</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="p-4 border-t border-[#f0f2f5] dark:border-[#2d3a48]">
                <button
                    class="w-full py-2.5 bg-[#f0f2f5] dark:bg-[#2d3a48] text-[#111418] dark:text-white font-bold rounded-lg hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
                    See All Notifications
                </button>
            </div>
        </aside>
    </div>

    <script>
        const notiBtn = document.getElementById('noti-btn');
        const notiBtnMobile = document.getElementById('noti-btn-mobile');
        const notiSidebar = document.getElementById('notifications-sidebar');
        const notiOverlay = document.getElementById('notifications-overlay');
        const closeNoti = document.getElementById('close-noti');

        function toggleNoti(show) {
            if (show) {
                notiOverlay.classList.remove('hidden');
                setTimeout(() => {
                    notiSidebar.classList.remove('translate-x-full');
                }, 10);
                document.body.classList.add('overflow-hidden');
            } else {
                notiSidebar.classList.add('translate-x-full');
                setTimeout(() => {
                    notiOverlay.classList.add('hidden');
                }, 300);
                document.body.classList.remove('overflow-hidden');
            }
        }

        if (notiBtn) notiBtn.addEventListener('click', () => toggleNoti(true));
        if (notiBtnMobile) notiBtnMobile.addEventListener('click', () => toggleNoti(true));
        if (closeNoti) closeNoti.addEventListener('click', () => toggleNoti(false));
    </script>
</body>

</html>